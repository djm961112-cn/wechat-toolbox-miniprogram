page { min-height: 100%; background: #f4f7fc; color: #17243d; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.page { box-sizing: border-box; min-height: 100vh; padding: 24rpx 26rpx 150rpx; }
.card { background: #fff; border: 1rpx solid rgba(224,232,244,.8); border-radius: 24rpx; box-shadow: 0 8rpx 26rpx rgba(41,66,111,.045); }
.muted { color: #8793a8; }
.tool-icon-wrap { position: relative; flex-shrink: 0; }
.tool-icon { display: block; width: 100%; height: 100%; }
