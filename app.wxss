page {
  min-height: 100%;
  background: #f6f7fb;
  color: #202431;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.page {
  padding: 32rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(31, 42, 68, 0.05);
}

.muted {
  color: #7c8394;
  font-size: 26rpx;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  border-radius: 18rpx;
  background: #3867f5;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}
