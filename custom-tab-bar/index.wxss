.tab-bar { position: fixed; z-index: 99; right: 0; bottom: 0; left: 0; display: flex; justify-content: space-around; padding: 12rpx 16rpx calc(12rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #edf0f5; background: rgba(255,255,255,.97); }
.tab-item { display: flex; min-width: 140rpx; flex-direction: column; align-items: center; color: #77849a; font-size: 21rpx; line-height: 1.5; }
.tab-item.active { color: #1677ff; font-weight: 600; }
.tab-icon { height: 42rpx; font-size: 34rpx; line-height: 42rpx; }
.tab-person { display: flex; height: 42rpx; flex-direction: column; align-items: center; justify-content: center; }
.tab-person-head { width: 13rpx; height: 13rpx; border: 3rpx solid #77849a; border-radius: 50%; }
.tab-person-body { width: 30rpx; height: 13rpx; margin-top: 2rpx; border: 3rpx solid #77849a; border-radius: 16rpx 16rpx 5rpx 5rpx; }
.tab-item.active .tab-person-head, .tab-item.active .tab-person-body { border-color: #1677ff; }
