.home-page { padding-top: 24rpx; }
.hero { position: relative; display: flex; height: 350rpx; box-sizing: border-box; align-items: center; overflow: hidden; padding: 40rpx; border: 0; border-radius: 34rpx; background: linear-gradient(125deg,#1685ff 0%,#438fff 56%,#85b8ff 100%); color: #fff; }
.hero::after { position: absolute; right: -70rpx; bottom: -150rpx; width: 480rpx; height: 320rpx; border-radius: 50%; background: rgba(255,255,255,.13); content: ''; }
.hero-copy { position: relative; z-index: 1; }
.hero-title { font-size: 48rpx; font-weight: 750; line-height: 1.22; letter-spacing: 2rpx; }
.hero-subtitle { margin-top: 22rpx; font-size: 24rpx; opacity: .92; }
.hero-art { position: absolute; z-index: 1; top: 82rpx; right: 54rpx; width: 160rpx; height: 160rpx; }
.hero-icon { width: 160rpx; height: 160rpx; filter: drop-shadow(0 10rpx 8rpx rgba(18,69,154,.16)); }
.home-panel { position: relative; margin-top: -30rpx; padding: 30rpx 24rpx 26rpx; border-radius: 30rpx 30rpx 0 0; background: #fff; }
.section-heading { display: flex; align-items: center; justify-content: space-between; margin: 4rpx 4rpx 22rpx; font-size: 32rpx; font-weight: 700; }
.section-more { color: #8190a7; font-size: 23rpx; font-weight: 400; }
.quick-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 18rpx 14rpx; }
.tool-tile { display: flex; min-height: 148rpx; flex-direction: column; align-items: center; justify-content: center; border: 1rpx solid #f0f3f8; border-radius: 20rpx; background: linear-gradient(145deg,#fbfcfe,#f4f7fb); }
.tool-icon-wrap { width: 78rpx; height: 78rpx; margin-bottom: 5rpx; }
.tool-name { color: #24324b; font-size: 22rpx; white-space: nowrap; }
.recommendation-heading { margin-top: 34rpx; }
.recommend-card { margin-bottom: 18rpx; padding: 20rpx 18rpx 18rpx; border-radius: 20rpx; box-shadow: none; }
.recommend-head { display: flex; align-items: center; justify-content: space-between; margin: 0 2rpx 16rpx; }
.recommend-title { font-size: 27rpx; font-weight: 650; }
.recommend-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 8rpx; }
.recommend-tool { display: flex; min-height: 134rpx; flex-direction: column; align-items: center; justify-content: center; border-radius: 16rpx; background: #f8f9fc; }
.tool-icon-wrap.small { width: 66rpx; height: 66rpx; margin-bottom: 4rpx; }
