<view class="page settings-page">
  <view class="settings-intro"><view class="settings-title">设置</view></view>
  <view class="preference-card card">
    <view class="preference-heading"><view class="section-title">喜好设置</view></view>
    <view wx:if="{{error}}" class="settings-error">{{error}}</view>
    <view wx:for="{{preferences}}" wx:key="id" class="preference-row">
      <image class="preference-icon" src="{{item.icon}}" mode="aspectFit" />
      <view class="preference-copy"><view class="preference-name">{{item.name}}</view><view class="preference-category">{{item.category}}</view></view>
      <switch checked="{{item.enabled}}" color="#25866a" data-id="{{item.id}}" bindchange="toggleTool" />
    </view>
  </view>
  <view class="cloud-card card">
    <view class="cloud-heading"><view><view class="section-title">本地数据上传</view><view class="cloud-subtitle">登录后将三类数据明文保存到服务器</view></view><text class="cloud-state">{{cloudLoggedIn ? '已登录' : '未登录'}}</text></view>
    <view class="cloud-message">{{cloudMessage}}</view>
    <view wx:if="{{cloudItems.length}}" class="cloud-list"><view wx:for="{{cloudItems}}" wx:key="tool" class="cloud-item"><text>{{item.name}}</text><text>修订 {{item.revision}}</text></view></view>
    <view wx:if="{{cloudError}}" class="cloud-error">{{cloudError}}</view>
    <button class="cloud-upload" loading="{{cloudLoading}}" disabled="{{cloudLoading}}" bindtap="uploadLocalData">{{cloudLoggedIn ? '上传并合并本地数据' : '登录并上传本地数据'}}</button>
    <view class="cloud-hint">仅上传 MFA（含 TOTP 密钥）、体重记录、模拟方案与来源。已有本地数据需主动上传，启用后的修改会自动同步；赛事缓存和未保存草稿不上传。</view>
  </view>
</view>
