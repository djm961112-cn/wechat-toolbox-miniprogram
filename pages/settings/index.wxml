<view class="page settings-page">
  <view class="settings-intro"><view class="settings-title">设置</view></view>
  <view class="preference-card card">
    <view class="preference-heading"><view class="section-title">喜好设置</view></view>
    <view wx:if="{{error}}" class="settings-error">{{error}}</view>
    <view wx:for="{{preferences}}" wx:key="id" class="preference-row">
      <image class="preference-icon" src="{{item.icon}}" mode="aspectFit" />
      <view class="preference-copy"><view class="preference-name">{{item.name}}</view><view class="preference-category">{{item.category}}</view></view>
      <switch checked="{{item.enabled}}" color="#25866a" data-id="{{item.id}}" bindchange="toggleTool" />
    </view>
  </view>
</view>
