.settings-page { padding-top: 28rpx; padding-bottom: calc(50rpx + env(safe-area-inset-bottom)); background: linear-gradient(180deg,#eaf4f0 0,#f4f7fc 420rpx); }
.settings-intro { padding: 4rpx 4rpx 24rpx; }
.settings-title { color: #1d3043; font-size: 39rpx; font-weight: 750; }
.preference-card { padding: 8rpx 26rpx; }
.preference-heading { padding: 22rpx 0 18rpx; }
.section-title { color: #203149; font-size: 29rpx; font-weight: 700; }
.preference-row { display: flex; min-height: 106rpx; align-items: center; border-top: 1rpx solid #edf1f3; }
.preference-icon { width: 64rpx; height: 64rpx; flex-shrink: 0; margin-right: 18rpx; }
.preference-copy { flex: 1; min-width: 0; }
.preference-name { color: #2a3c50; font-size: 25rpx; font-weight: 650; }
.preference-category { margin-top: 5rpx; color: #98a4b2; font-size: 19rpx; }
.settings-error { padding: 30rpx 0; border-top: 1rpx solid #edf1f3; color: #bd665b; font-size: 22rpx; text-align: center; }
.cloud-card { margin-top: 22rpx; padding: 26rpx; }
.cloud-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.cloud-subtitle { margin-top: 7rpx; color: #94a1ae; font-size: 20rpx; }
.cloud-state { flex-shrink: 0; padding: 7rpx 13rpx; border-radius: 99rpx; background: #eaf5f0; color: #25866a; font-size: 18rpx; }
.cloud-message { margin-top: 18rpx; color: #617383; font-size: 21rpx; line-height: 1.55; }
.cloud-list { margin-top: 14rpx; border-top: 1rpx solid #edf1f3; }
.cloud-item { display: flex; justify-content: space-between; gap: 12rpx; padding: 14rpx 0; border-bottom: 1rpx solid #edf1f3; color: #43576a; font-size: 20rpx; }
.cloud-item text:last-child { color: #98a4b1; }
.cloud-error { margin-top: 12rpx; color: #bd5d54; font-size: 20rpx; line-height: 1.5; }
.cloud-upload { margin-top: 20rpx; border-radius: 14rpx; background: #25866a; color: #fff; font-size: 23rpx; line-height: 76rpx; }
.cloud-upload[disabled] { background: #a6c9bd; color: #fff; }
.cloud-upload::after { border: none; }
.cloud-hint { margin-top: 14rpx; color: #9aa5b1; font-size: 18rpx; line-height: 1.55; }
