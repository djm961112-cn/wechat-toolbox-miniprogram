<view class="page mine-page">
  <view class="profile-card card"><view class="avatar">{{user ? '微' : '我'}}</view><view class="profile-copy"><view class="profile-name">{{user ? user.displayName : '本地用户'}}</view><view class="profile-status">{{user ? '已登录 · 用户 #' + user.id : '本地模式'}}</view></view><button wx:if="{{loginEnabled && !user}}" class="login-button" loading="{{loginLoading}}" disabled="{{loginLoading}}" bindtap="login">微信登录</button><text wx:elif="{{loginEnabled && user}}" class="logout-button" bindtap="logout">退出</text></view>
  <view class="profile-hint">{{loginEnabled ? (user ? '登录状态来自 OpenOTools 服务器，本机工具数据暂未自动同步。' : '登录后可逐步启用云端同步；未登录也可以继续使用本地工具。') : '当前使用本地模式，工具数据保存在本机。'}}</view>
  <view wx:if="{{authLoading}}" class="auth-message">正在校验登录状态…</view>
  <view wx:if="{{authError}}" class="auth-message error">{{authError}}</view>

  <view class="score-card card">
    <view class="score-heading"><view><view class="section-title">给工具箱打分</view><view class="section-subtitle">选择 1 至 10 分，记录你的使用感受</view></view><view class="current-score">{{savedScore === null ? '未评分' : savedScore + '分'}}</view></view>
    <view class="score-grid"><view wx:for="{{scoreOptions}}" wx:key="*this" class="score-option {{draftScore === item ? 'active' : ''}}" data-score="{{item}}" bindtap="chooseScore">{{item}}</view></view>
    <view class="manual-score"><text>手动输入</text><input type="number" maxlength="2" value="{{manualScore}}" placeholder="输入分数" bindinput="inputManualScore" /><text>分</text></view>
    <button class="save-score" bindtap="saveScore">保存评分</button>
    <view wx:if="{{savedAt}}" class="saved-time">上次保存：{{savedAt}}</view>
  </view>

  <view class="links-card card"><view class="link-row" bindtap="openSettings"><view class="link-name"><text class="link-symbol">⚙</text><text>设置</text></view><text class="link-arrow">›</text></view><view class="link-row" bindtap="openPrivacy"><text>隐私政策</text><text class="link-arrow">›</text></view><view class="link-row" bindtap="openTerms"><text>用户服务协议</text><text class="link-arrow">›</text></view></view>
  <view class="local-note">评分和工具喜好仅保存在当前设备，清理缓存或删除小程序可能导致记录丢失。</view>
</view>
