.mine-page { padding-top: 30rpx; background: linear-gradient(180deg,#e9f4f0 0,#f4f7fc 440rpx); }
.profile-card { display: flex; align-items: center; padding: 30rpx; }
.avatar { display: flex; width: 100rpx; height: 100rpx; flex-shrink: 0; align-items: center; justify-content: center; margin-right: 22rpx; border-radius: 50%; background: #dff1e9; color: #25866a; font-size: 43rpx; font-weight: 700; }
.profile-copy { min-width: 0; }
.profile-name { color: #1d2e43; font-size: 32rpx; font-weight: 700; }
.profile-status { display: inline-block; margin-top: 10rpx; padding: 5rpx 13rpx; border-radius: 99rpx; background: #eaf5f0; color: #25866a; font-size: 20rpx; }
.login-button { flex-shrink: 0; margin: 0 0 0 auto; padding: 0 24rpx; border: 0; border-radius: 14rpx; background: #25866a; color: #fff; font-size: 22rpx; line-height: 62rpx; }
.login-button::after { border: 0; }
.login-button[disabled] { background: #9fcbbd; color: #fff; opacity: 1; }
.logout-button { flex-shrink: 0; margin-left: auto; padding: 14rpx 4rpx 14rpx 18rpx; color: #8795a7; font-size: 21rpx; }
.profile-hint { margin: 16rpx 10rpx 24rpx; color: #8795a7; font-size: 21rpx; line-height: 1.6; }
.auth-message { margin: -10rpx 10rpx 22rpx; color: #25866a; font-size: 20rpx; }
.auth-message.error { color: #c26055; }
.score-card { padding: 28rpx; }
.score-heading { display: flex; justify-content: space-between; align-items: flex-start; gap: 12rpx; }
.section-title { color: #203149; font-size: 29rpx; font-weight: 700; }
.section-subtitle { margin-top: 8rpx; color: #8895a7; font-size: 21rpx; }
.current-score { flex-shrink: 0; color: #25866a; font-size: 24rpx; font-weight: 650; }
.score-grid { display: grid; grid-template-columns: repeat(5,1fr); gap: 12rpx; margin-top: 26rpx; }
.score-option { display: flex; height: 74rpx; align-items: center; justify-content: center; border: 1rpx solid #dfe8e3; border-radius: 13rpx; background: #f8fbf9; color: #697b74; font-size: 25rpx; }
.score-option.active { border-color: #73b99e; background: #e4f4ec; color: #25866a; font-weight: 700; }
.save-score { margin-top: 25rpx; border: 0; border-radius: 15rpx; background: #25866a; color: #fff; font-size: 24rpx; }
.save-score::after { border: 0; }
.saved-time { margin-top: 15rpx; color: #9aa6b2; font-size: 19rpx; text-align: center; }
.links-card { margin-top: 20rpx; padding: 0 25rpx; }
.link-row { display: flex; min-height: 94rpx; align-items: center; justify-content: space-between; color: #425268; font-size: 24rpx; }
.link-row + .link-row { border-top: 1rpx solid #edf1f3; }
.link-arrow { color: #a0adba; font-size: 36rpx; }
.link-name { display: flex; align-items: center; gap: 14rpx; }
.link-symbol { color: #6d8090; font-size: 28rpx; }
.local-note { margin: 26rpx 14rpx; color: #9aa6b2; font-size: 20rpx; line-height: 1.6; text-align: center; }
