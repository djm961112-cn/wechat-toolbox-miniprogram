<view class="page">
  <view class="card intro">
    <view class="heading">BMI 计算器</view>
    <view class="muted">输入身高和体重，查看身体质量指数</view>
  </view>
  <view class="card form">
    <view class="field-label">身高（cm）</view>
    <input class="input" type="digit" value="{{height}}" data-field="height" bindinput="onInput" placeholder="例如 170" />
    <view class="field-label next">体重（kg）</view>
    <input class="input" type="digit" value="{{weight}}" data-field="weight" bindinput="onInput" placeholder="例如 65" />
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button class="primary-button calculate" bindtap="calculate">计算 BMI</button>
  </view>
  <view wx:if="{{bmi}}" class="card result">
    <view class="muted">你的 BMI</view>
    <view class="number">{{bmi}}</view>
    <view class="badge">{{category}}</view>
    <view class="muted note">成人参考区间：18.5–23.9。BMI 仅供参考，不作为医疗诊断。</view>
  </view>
</view>
