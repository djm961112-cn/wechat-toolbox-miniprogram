.intro { margin-bottom: 20rpx; }
.heading { margin-bottom: 10rpx; font-size: 36rpx; font-weight: 700; }
.form { padding: 32rpx; }
.field-label { margin-bottom: 12rpx; font-size: 26rpx; font-weight: 600; }
.next { margin-top: 28rpx; }
.input { box-sizing: border-box; width: 100%; height: 88rpx; padding: 0 22rpx; border: 2rpx solid #e8ebf2; border-radius: 16rpx; background: #fbfcfe; font-size: 30rpx; }
.calculate { margin-top: 34rpx; }
.error { margin-top: 14rpx; color: #d94d4d; font-size: 24rpx; }
.result { margin-top: 20rpx; text-align: center; }
.number { margin: 8rpx 0; color: #3867f5; font-size: 72rpx; font-weight: 700; }
.badge { display: inline-block; padding: 8rpx 22rpx; border-radius: 999rpx; background: #edf2ff; color: #3867f5; font-size: 26rpx; }
.note { display: block; margin-top: 22rpx; font-size: 22rpx; line-height: 1.6; }
