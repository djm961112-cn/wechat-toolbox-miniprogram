@import "../choices.wxss";
.detail-page { padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.analysis-head { padding: 24rpx; text-align: center; background: linear-gradient(135deg, #283c51, #17283b); color: #fff; }
.analysis-meta { display: flex; justify-content: center; gap: 16rpx; color: rgba(255,255,255,.68); font-size: 20rpx; }
.analysis-teams { display: grid; grid-template-columns: minmax(0,1fr) auto minmax(0,1fr); align-items: center; gap: 20rpx; margin-top: 20rpx; font-size: 30rpx; font-weight: 750; word-break: break-all; }
.analysis-teams text:first-child { text-align: right; }
.analysis-teams text:last-child { text-align: left; }
.analysis-vs { color: #ff625b; font-size: 34rpx; }
.analysis-time { margin-top: 14rpx; color: rgba(255,255,255,.72); font-size: 21rpx; }
.analysis-notice { margin: 16rpx 0; padding: 14rpx 18rpx; border-radius: 12rpx; background: #fff5ec; color: #966c49; font-size: 19rpx; line-height: 1.5; }
.analysis-title { padding-left: 12rpx; border-left: 6rpx solid #e54841; }
.analysis-empty { padding: 30rpx 0; color: #99a4b2; text-align: center; font-size: 22rpx; }
.feature-row { padding: 18rpx 0; }
.feature-row + .feature-row { border-top: 1rpx solid #edf1f5; }
.feature-values { display: grid; grid-template-columns: minmax(0,1fr) 190rpx minmax(0,1fr); gap: 10rpx; align-items: center; color: #5c6876; font-size: 21rpx; }
.feature-values text:nth-child(2) { color: #26394c; text-align: center; font-size: 22rpx; }
.feature-values text:last-child { text-align: right; }
.feature-bars { display: grid; grid-template-columns: 1fr 1fr; gap: 8rpx; margin-top: 12rpx; }
.feature-track { position: relative; height: 10rpx; border-radius: 99rpx; background: #edf0f3; overflow: hidden; }
.feature-track.left { transform: scaleX(-1); }
.feature-fill { height: 100%; border-radius: 99rpx; background: #e54841; }
.feature-fill.away { background: #788797; }
.history-row { padding: 18rpx 0; }
.history-row + .history-row { border-top: 1rpx solid #edf1f5; }
.history-meta { display: flex; justify-content: space-between; color: #98a3b3; font-size: 18rpx; }
.history-match { display: grid; grid-template-columns: minmax(0,1fr) 82rpx minmax(0,1fr); gap: 12rpx; align-items: center; margin-top: 10rpx; color: #33475a; font-size: 22rpx; word-break: break-all; }
.history-match text:first-child { text-align: right; }
.history-score { color: #e54841; text-align: center; font-size: 25rpx; font-weight: 750; }
.single-match-card { padding: 26rpx; text-align: center; }
.single-meta { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; color: #8793a8; font-size: 20rpx; text-align: left; }
.single-mode { flex-shrink: 0; padding: 7rpx 14rpx; border-radius: 99rpx; background: #fff0ee; color: #d6463f; font-size: 19rpx; }
.single-teams { display: grid; grid-template-columns: minmax(0,1fr) auto minmax(0,1fr); align-items: center; gap: 18rpx; margin-top: 32rpx; color: #26394c; font-size: 28rpx; font-weight: 700; word-break: break-all; }
.single-score { color: #d6463f; font-size: 42rpx; font-weight: 800; }
.single-score text { display: block; margin-top: 5rpx; color: #96a1ae; font-size: 19rpx; font-weight: 400; }
.single-status { margin-top: 18rpx; color: #68788a; font-size: 22rpx; }
.single-error { margin-top: 12rpx; color: #bd665b; font-size: 20rpx; }
.single-refresh { display: inline-block; margin-top: 20rpx; padding: 11rpx 30rpx; border-radius: 99rpx; background: #fff0ee; color: #d6463f; font-size: 21rpx; }
.single-live-note { margin: 20rpx 10rpx; color: #8d99a8; font-size: 20rpx; line-height: 1.65; text-align: center; }
.single-retry { margin-top: 18rpx; color: #d6463f; }
.simulation-notice { margin-bottom: 18rpx; padding: 16rpx 20rpx; border-radius: 14rpx; background: #eaf5f0; color: #4d7868; font-size: 20rpx; line-height: 1.5; }
.summary, .section { padding: 26rpx; margin-bottom: 22rpx; }
.summary-time { color: #8793a8; font-size: 21rpx; }
.meta { margin-top: 8rpx; font-size: 20rpx; }
.metrics { margin-top: 24rpx; color: #608578; font-size: 24rpx; }
.pass-label { margin-top: 12rpx; color: #78869b; font-size: 23rpx; word-break: break-all; }
.money { display: flex; gap: 20rpx; margin-top: 22rpx; padding: 20rpx; border-radius: 16rpx; background: #edf7f2; }
.money view { flex: 1; color: #7b889a; font-size: 20rpx; }
.money text { display: block; margin-top: 8rpx; color: #25866a; font-size: 26rpx; font-weight: 650; word-break: break-all; }
.settlement-summary { margin-top: 18rpx; padding: 20rpx 24rpx; border-radius: 14rpx; font-size: 23rpx; line-height: 1.7; }
.settlement-summary.terminal { background: #eaf7f0; color: #25866a; }
.settlement-summary.waiting { background: #f3f5f8; color: #66778c; }
.settlement-status { font-size: 28rpx; font-weight: 750; }
.settlement-prize { color: #d74639; font-size: 44rpx; font-weight: 800; }
.settlement-score { margin-top: 6rpx; font-size: 22rpx; }
.result-card + .result-card { margin-top: 26rpx; padding-top: 22rpx; border-top: 1rpx solid #edf1f5; }
.result-meta { display: flex; justify-content: space-between; gap: 12rpx; color: #8793a8; font-size: 20rpx; }
.result-teams { display: grid; grid-template-columns: 1fr auto 1fr; gap: 12rpx; align-items: center; text-align: center; margin: 18rpx 0; font-size: 25rpx; word-break: break-all; }
.result-score { font-size: 33rpx; font-weight: 650; }
.result-score text { display: block; margin-top: 6rpx; color: #98a3b3; font-size: 19rpx; font-weight: 400; }
.result-pools { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); border: 1rpx solid #dce8e2; border-radius: 12rpx; overflow: hidden; }
.result-pool { text-align: center; min-width: 0; border-right: 1rpx solid #dce8e2; }
.result-pool:last-child { border-right: none; }
.result-pool-name { display: flex; align-items: center; justify-content: center; min-height: 66rpx; padding: 6rpx; border-bottom: 1rpx solid #dce8e2; color: #8793a8; background: #f7fbf9; font-size: 19rpx; box-sizing: border-box; }
.result-outcome { margin: 14rpx 4rpx 8rpx; color: #98a3b3; font-size: 22rpx; word-break: break-all; }
.result-outcome.published { color: #d67464; }
.result-odds { margin-bottom: 14rpx; color: #8793a8; font-size: 20rpx; }
.hint { margin-top: 16rpx; color: #98a3b3; font-size: 20rpx; line-height: 1.7; }
.section-title { font-size: 28rpx; font-weight: 650; margin-bottom: 18rpx; }
.match { padding: 18rpx 0; border-top: 1rpx solid #edf1f5; font-size: 24rpx; word-break: break-all; }
.note { margin-top: 20rpx; padding: 18rpx; background: #f7f9fc; border-radius: 14rpx; color: #78869b; font-size: 23rpx; white-space: pre-wrap; }
.ticket { margin-bottom: 12rpx; padding: 18rpx; background: #f7f9fc; border-radius: 14rpx; }
.ticket-title { color: #536a60; font-size: 22rpx; }
.ticket.won { border: 2rpx solid #55b589; background: #edf9f1; }
.ticket-verdict { margin-top: 8rpx; color: #8793a8; font-size: 21rpx; }
.ticket.won .ticket-verdict { color: #25866a; font-weight: 650; }
.ticket-choices { margin-top: 8rpx; color: #8491a4; font-size: 20rpx; line-height: 1.7; word-break: break-all; }
.entry-group { padding: 18rpx; border: 1rpx solid #dce8e2; border-radius: 16rpx; margin-bottom: 18rpx; }
.group-title { color: #25866a; font-size: 24rpx; font-weight: 650; }
.group-choices { margin: 12rpx 0 18rpx; color: #608578; font-size: 22rpx; line-height: 1.7; word-break: break-all; }
.load-more { padding: 18rpx; color: #25866a; text-align: center; font-size: 24rpx; }
.empty { padding: 60rpx 26rpx; text-align: center; color: #8793a8; font-size: 25rpx; }
