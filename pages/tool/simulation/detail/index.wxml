<view class="page detail-page">
  <view wx:if="{{analysisLoading && !analysis}}" class="empty card">正在查询官方对阵数据…</view>
  <view wx:elif="{{analysisError && !analysis}}" class="empty card"><view>{{analysisError}}</view><view class="single-retry" bindtap="refreshAnalysis">重试</view></view>
  <block wx:elif="{{analysis}}">
    <view class="analysis-head card">
      <view class="analysis-meta"><text>{{analysis.header.league}}</text><text>{{analysis.header.number}}</text></view>
      <view class="analysis-teams"><text>{{analysis.header.home}}</text><text class="analysis-vs">VS</text><text>{{analysis.header.away}}</text></view>
      <view class="analysis-time">{{analysis.header.time}}</view>
    </view>
    <view class="analysis-notice">数据来自中国竞彩网公开对阵数据，仅供个人分析参考。</view>
    <view wx:if="{{analysis.partialError}}" class="analysis-partial">部分官方数据暂时不可用，可稍后刷新重试。</view>
    <scroll-view class="analysis-tab-scroll" scroll-x="true" enhanced="true"><view class="analysis-tabs"><view wx:for="{{analysisTabs}}" wx:key="id" class="analysis-tab {{analysisTab === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectAnalysisTab">{{item.name}}</view></view></scroll-view>
    <view wx:if="{{analysisTab === 'feature'}}" class="section card">
      <view class="section-title analysis-title">特征分析</view>
      <view wx:if="{{!analysis.featureRows.length}}" class="analysis-empty">暂无特征分析数据</view>
      <view wx:for="{{analysis.featureRows}}" wx:key="id" class="feature-row">
        <view class="feature-values"><text>{{item.home}}</text><text>{{item.title}}</text><text>{{item.away}}</text></view>
        <view class="feature-bars"><view class="feature-track left"><view class="feature-fill" style="width: {{item.homeRatio}}%;"></view></view><view class="feature-track right"><view class="feature-fill away" style="width: {{item.awayRatio}}%;"></view></view></view>
      </view>
    </view>
    <view wx:elif="{{analysisTab === 'history'}}" class="section card">
      <view class="section-title analysis-title">历史交锋</view><view wx:if="{{analysis.history.summary}}" class="analysis-summary">{{analysis.history.summary}}</view>
      <view wx:if="{{!analysis.history.matches.length}}" class="analysis-empty">暂无历史交锋数据</view>
      <view wx:for="{{analysis.history.matches}}" wx:key="id" class="history-row"><view class="history-meta"><text>{{item.league}}</text><text>{{item.date}}</text></view><view class="history-match"><text>{{item.home}}</text><view class="history-score">{{item.score || '-' }}<text>半场 {{item.half || '-'}}</text></view><text>{{item.away}}</text></view></view>
    </view>
    <view wx:elif="{{analysisTab === 'table'}}" class="section card">
      <view class="section-title analysis-title">积分榜<text class="analysis-subtitle">{{analysis.table.title}}</text></view>
      <view wx:if="{{!analysis.table.rows.length}}" class="analysis-empty">该赛事暂无积分榜数据</view>
      <view wx:else class="table-list"><view class="table-row table-head"><text>排名</text><text>球队</text><text>场次</text><text>胜/平/负</text><text>胜率</text><text>积分</text></view><view wx:for="{{analysis.table.rows}}" wx:key="id" class="table-row"><text>{{item.rank}}</text><text>{{item.team}}</text><text>{{item.played}}</text><text>{{item.form}}</text><text>{{item.winRate}}</text><text>{{item.points}}</text></view></view>
    </view>
    <view wx:elif="{{analysisTab === 'recent'}}" class="section card">
      <view class="section-title analysis-title">比赛近况</view>
      <view wx:for="{{analysis.recent}}" wx:for-item="team" wx:key="id" class="team-block"><view class="team-title">{{team.team || (team.id === 'home' ? analysis.header.home : analysis.header.away)}}</view><view wx:if="{{team.summary}}" class="analysis-summary">{{team.summary}}<text>{{team.goals}}</text></view><view wx:if="{{!team.matches.length}}" class="analysis-empty compact">暂无数据</view><view wx:for="{{team.matches}}" wx:for-item="match" wx:key="id" class="form-row"><view class="form-meta"><text>{{match.league}}</text><text>{{match.date}}</text></view><view class="form-match"><text>{{match.home}}</text><view class="form-score">{{match.score || '-'}}<text>半场 {{match.half || '-'}}</text></view><text>{{match.away}}</text><text class="result-badge {{match.result === '胜' ? 'win' : match.result === '平' ? 'draw' : match.result === '负' ? 'loss' : ''}}">{{match.result}}</text></view></view></view>
    </view>
    <view wx:elif="{{analysisTab === 'future'}}" class="section card">
      <view class="section-title analysis-title">未来赛事</view>
      <view wx:for="{{analysis.future}}" wx:for-item="team" wx:key="id" class="team-block"><view class="team-title">{{team.team || (team.id === 'home' ? analysis.header.home : analysis.header.away)}}</view><view wx:if="{{!team.matches.length}}" class="analysis-empty compact">暂无数据</view><view wx:for="{{team.matches}}" wx:for-item="match" wx:key="id" class="future-row"><view class="future-meta"><text>{{match.date}} {{match.time}}</text><text>{{match.league}} {{match.stage}}</text></view><view class="future-match"><text>{{match.home}}</text><text>VS</text><text>{{match.away}}</text></view></view></view>
    </view>
    <view wx:elif="{{analysisTab === 'scorer'}}" class="section card">
      <view class="section-title analysis-title">射手信息<text class="analysis-subtitle">{{analysis.scorer.title}}</text></view>
      <view wx:for="{{analysis.scorer.teams}}" wx:for-item="team" wx:key="id" class="team-block"><view class="team-title">{{team.team || (team.id === 'home' ? analysis.header.home : analysis.header.away)}}</view><view wx:if="{{!team.players.length}}" class="analysis-empty compact">暂无数据</view><view class="player-grid"><view wx:for="{{team.players}}" wx:for-item="player" wx:key="id" class="player-card"><view class="player-head"><text class="player-no">{{player.no}}</text><view><text class="player-name">{{player.name}}</text><text class="player-position">{{player.position}}<text wx:if="{{player.injured}}"> · 伤</text><text wx:if="{{player.suspended}}"> · 停</text></text></view></view><view class="player-counts"><text>总场 {{player.appearances}}</text><text>首发 {{player.starts}}</text><text>替补 {{player.substitutes}}</text></view><view class="player-output"><text>进球 {{player.goals}} / {{player.goalRate}}</text><text>助攻 {{player.assists}} / {{player.assistRate}}</text><text>场均 {{player.goalAvg}}球</text></view></view></view></view>
    </view>
    <view wx:elif="{{analysisTab === 'injury'}}" class="section card">
      <view class="section-title analysis-title">伤停一览</view>
      <view wx:for="{{analysis.injury}}" wx:for-item="team" wx:key="id" class="team-block"><view class="team-title">{{team.team || (team.id === 'home' ? analysis.header.home : analysis.header.away)}}</view><view wx:if="{{!team.players.length}}" class="analysis-empty compact">暂无数据</view><view class="player-grid"><view wx:for="{{team.players}}" wx:for-item="player" wx:key="id" class="player-card injury-card"><view class="player-head"><text class="player-no">{{player.no}}</text><view><text class="player-name">{{player.name}}</text><text class="player-position">{{player.position}}</text></view><text class="injury-status">{{player.status}}</text></view><view class="player-counts"><text>总场 {{player.appearances}}</text><text>首发 {{player.starts}}</text><text>替补 {{player.substitutes}}</text></view></view></view></view>
      <view class="analysis-footnote">赛事统计以全场 90 分钟（含伤停补时）为准，实际数据以官方公布内容为准。</view>
    </view>
  </block>
  <view wx:elif="{{matchLoading && !matchPage}}" class="empty card">正在查询比赛数据…</view>
  <view wx:elif="{{matchError && !matchPage}}" class="empty card"><view>{{matchError}}</view><view class="single-retry" bindtap="refreshMatchPage">重试</view></view>
  <block wx:elif="{{matchPage}}">
    <view class="single-match-card card">
      <view class="single-meta"><text>{{matchPage.result.league}} · {{matchPage.result.period}}期 · {{matchPage.result.number}}</text><text class="single-mode">{{matchPage.mode === 'result' ? '赛果' : '比分直播'}}</text></view>
      <view class="single-teams"><text>{{matchPage.result.home}}</text><view class="single-score">{{matchPage.result.fullScore}}<text>半场 {{matchPage.result.halfScore}}</text></view><text>{{matchPage.result.away}}</text></view>
      <view class="single-status">{{matchPage.result.statusLabel}}</view>
      <view wx:if="{{matchError}}" class="single-error">{{matchError}}</view>
      <view class="single-refresh" bindtap="refreshMatchPage">{{matchLoading ? '刷新中…' : '刷新'}}</view>
    </view>
    <view wx:if="{{matchPage.mode === 'result'}}" class="section card">
      <view class="section-title">玩法赛果</view>
      <view class="result-pools"><view wx:for="{{matchPage.result.pools}}" wx:for-item="pool" wx:key="id" class="result-pool"><view class="result-pool-name">{{pool.name}}</view><view class="result-outcome {{pool.state === 'settled' ? 'published' : ''}}">{{pool.resultText}}</view><view class="result-odds">{{pool.odds}}</view></view></view>
      <view class="hint">玩法赛果和参考赔率来自官方已公布数据。</view>
    </view>
    <view wx:else class="single-live-note">比分直播每 30 秒自动刷新；正式玩法赛果公布后会自动切换为赛果详情。</view>
  </block>
  <view wx:elif="{{error}}" class="empty card">{{error}}</view>
  <block wx:elif="{{plan}}">
    <view class="simulation-notice">本页仅展示已保存方案的本地模拟值与赛果匹配情况，不提供真实投注、支付、出票或兑奖。</view>
    <view class="summary card">
      <view class="summary-time">保存于 {{plan.createdTime}}</view>
      <view class="metrics">{{plan.count}} 组 · {{plan.multiplier}} 倍</view>
      <view class="pass-label">组合方式：{{plan.passLabel}}</view>
      <view class="pass-label">所属期号：{{plan.periodLabel || '未记录'}}</view>
      <view class="pass-label">方案来源：{{plan.planSourceName || '未关联'}}<text wx:if="{{plan.planSourceId}}">（{{plan.planSourceId}}）</text></view>
      <view class="pass-label">实际购买：{{plan.purchased ? '是' : '否'}}</view>
      <view class="money"><view>模拟投入<text>¥{{plan.cost}}</text></view><view>{{plan.needsOdds ? '模拟回报区间' : plan.minReturn ? '模拟回报区间' : '历史模拟回报上限'}}<text>{{plan.needsOdds ? '待赔率 / 让球数' : (plan.minReturn ? '¥' + plan.minReturn + ' ～ ' : '') + '¥' + plan.maxReturn}}</text></view></view>
      <view class="hint">区间为至少一组与赛果匹配时的模拟回报，未计逐项舍入、上限及税费，不代表实际收益。</view>
      <view wx:if="{{plan.capped}}" class="hint">包含可能触及计算上限的组合，实际模拟回报可能低于上述估算。</view>
      <view wx:if="{{plan.check}}" class="settlement-summary {{plan.check.status === 'complete' ? 'terminal' : 'waiting'}}">
        <block wx:if="{{plan.check.status !== 'complete'}}"><view class="settlement-status">比赛未结束</view><view wx:for="{{plan.check.pendingScores}}" wx:for-item="score" wx:key="*this" class="settlement-score">{{score}}</view><view wx:if="{{!plan.check.pendingScores || !plan.check.pendingScores.length}}" class="settlement-score">暂未查到最终赛果，请稍后再核对</view></block>
        <block wx:elif="{{plan.check.outcome === 'won' || !plan.check.outcome && plan.check.prizeAmount !== '0.00'}}"><view class="settlement-status">已中奖 · 模拟回报</view><view class="settlement-prize">¥{{plan.check.prizeAmount}}</view></block>
        <block wx:elif="{{plan.check.outcome === 'refund' || plan.check.refundCount}}"><view class="settlement-status">场次无效 · 模拟返还</view><view class="settlement-prize">¥{{plan.check.refundAmount}}</view></block>
        <view wx:else class="settlement-status">未中奖</view><view class="hint">核对时间：{{plan.checkedTime}}</view>
      </view>
    </view>
    <view class="section card">
      <view class="section-title">比赛选择</view>
      <view wx:for="{{plan.matches}}" wx:key="id" class="match"><view>{{item.label}}</view><view class="meta muted">{{item.date}} {{item.time}}</view><view class="simulation-choice-box columns-{{item.selectionRows[0].columns}}"><view wx:for="{{item.selectionRows}}" wx:for-item="row" wx:key="id" class="simulation-choice-row"><text wx:for="{{row.options}}" wx:for-item="choice" wx:key="key" class="simulation-choice-cell">{{choice.text}}</text></view></view></view>
      <view class="hint">官方数据更新：{{plan.sourceUpdatedAt}}<view>查询时间：{{plan.fetchedAt}} · {{plan.needsOdds ? '部分赔率或让球数待公布，可返回列表补全' : plan.pricingNote || '保存时赔率快照'}}</view></view>
      <view wx:if="{{plan.note}}" class="note">{{plan.note}}</view>
    </view>
    <view class="section card">
      <view class="section-title">赛果</view>
      <view wx:if="{{!plan.check}}" class="hint">请在「我的方案」点击「核对」，查询并保存比赛赛果。</view>
      <block wx:else>
        <view wx:for="{{plan.check.results}}" wx:key="matchId" class="result-card">
          <view class="result-meta"><text>{{item.league}} · {{item.period}}期 · {{item.number}}</text><text>{{item.statusLabel}}</text></view>
          <view class="result-teams"><text>{{item.home}}</text><view class="result-score">{{item.fullScore}}<text>半场 {{item.halfScore}}</text></view><text>{{item.away}}</text></view>
          <view class="result-pools"><view wx:for="{{item.pools}}" wx:for-item="pool" wx:key="id" class="result-pool"><view class="result-pool-name">{{pool.name}}</view><view class="result-outcome {{pool.state === 'settled' ? 'published' : ''}}">{{pool.resultText}}</view><view class="result-odds">{{pool.odds}}</view></view></view>
          <view wx:if="{{item.fromCache}}" class="hint">本次未取得新赛果，沿用此前已缓存赛果。</view>
          <view wx:if="{{item.lookupBySavedId}}" class="hint">按保存的历史比赛信息取得赛果，未返回的比分显示为「—」。</view>
        </view>
        <view class="hint">赛果栏展示官方公布的参考赔率；模拟回报按保存时的赔率、倍数和组合方式计算，不代表实际收益。</view>
      </block>
    </view>
    <view class="section card">
      <view class="section-title">逐项组合（{{entryCount}} / {{plan.count}} 组）</view>
      <view wx:for="{{entryGroups}}" wx:for-item="group" wx:key="id" class="entry-group">
        <view class="group-title">{{group.title}} · {{group.count}} 组</view><view class="group-choices">{{group.choices}}</view>
        <view wx:for="{{group.entries}}" wx:key="id" class="ticket {{item.status === 'won' ? 'won' : ''}}"><view class="ticket-title">{{item.label}} · 模拟回报 {{item.returnAmount === '待赔率' ? '待赔率' : '¥' + item.returnAmount}}</view><view wx:if="{{item.statusLabel}}" class="ticket-verdict">{{item.statusLabel}}{{item.prize !== null && item.prize ? ' · 模拟回报 ¥' + item.prize : ''}}</view><view class="ticket-choices">{{item.choices}}</view></view>
        <view wx:if="{{group.entries.length < group.count}}" class="hint">本组已显示 {{group.entries.length}} / {{group.count}} 组，点击下方加载更多继续展开。</view>
      </view>
      <view wx:if="{{entryError}}" class="hint">{{entryError}}</view>
      <view wx:elif="{{entryCount < plan.count}}" class="load-more" bindtap="loadMoreEntries">加载更多组合</view>
      <view class="hint">逐项模拟值按保存的赔率、倍数及上限计算，仅供个人复盘，不是兑奖结果。</view>
    </view>
  </block>
</view>
