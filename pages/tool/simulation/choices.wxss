.simulation-choice-box { margin-top: 12rpx; border: 1rpx solid #dce8e2; border-radius: 12rpx; overflow: hidden; }
.simulation-choice-row { display: grid; background: #f7fbf9; }
.simulation-choice-row + .simulation-choice-row { border-top: 1rpx solid #dce8e2; }
.simulation-choice-cell { padding: 12rpx 8rpx; border-right: 1rpx solid #dce8e2; color: #608578; text-align: center; font-size: 22rpx; line-height: 1.6; word-break: break-all; }
.simulation-choice-cell:last-child { border-right: none; }
