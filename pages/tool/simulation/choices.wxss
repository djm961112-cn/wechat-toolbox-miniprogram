.simulation-choice-box { margin-top: 12rpx; display: flex; flex-direction: column; gap: 8rpx; }
.simulation-choice-row { display: grid; grid-template-columns: repeat(3, minmax(0, 176rpx)) !important; gap: 8rpx; }
.simulation-choice-cell { box-sizing: border-box; min-width: 0; padding: 12rpx 8rpx; border: 1rpx solid #dce8e2; border-radius: 10rpx; background: #f7fbf9; color: #608578; text-align: center; font-size: 22rpx; line-height: 1.6; word-break: break-all; }
