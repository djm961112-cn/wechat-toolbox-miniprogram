@import "./choices.wxss";
.intro { padding: 10rpx 4rpx 24rpx; }
.intro-title { font-size: 38rpx; font-weight: 700; }
.intro-subtitle { margin-top: 8rpx; color: #8793a8; font-size: 22rpx; }
.simulation-notice { margin-bottom: 20rpx; padding: 16rpx 20rpx; border-radius: 14rpx; background: #eaf5f0; color: #4d7868; font-size: 20rpx; line-height: 1.5; }
.tabs { position: sticky; z-index: 35; top: 0; display: flex; padding: 8rpx; margin-bottom: 24rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 8rpx 22rpx rgba(41,66,111,.08); }
.tab { flex: 1; padding: 20rpx 0; color: #8793a8; font-size: 26rpx; text-align: center; border-radius: 14rpx; }
.tab.active { background: #eaf7f3; color: #25866a; font-weight: 650; }
.stats-note { padding: 18rpx 20rpx; border-radius: 16rpx; background: #eff6f3; color: #5c7a6d; font-size: 21rpx; line-height: 1.5; }
.stats-tools { margin: 22rpx 0; }
.stats-switch { display: flex; padding: 7rpx; margin-bottom: 18rpx; border-radius: 18rpx; box-shadow: none; }
.stats-switch-item { flex: 1; padding: 17rpx 0; color: #8492a2; text-align: center; font-size: 24rpx; border-radius: 12rpx; }
.stats-switch-item.selected { color: #25866a; background: #e8f5ef; font-weight: 700; }
.stats-filters { display: flex; align-items: center; gap: 12rpx; margin-bottom: 18rpx; }
.stats-filter { min-width: 132rpx; padding: 14rpx 18rpx; border: 1rpx solid #dce6e1; border-radius: 12rpx; background: #fff; color: #30495c; font-size: 22rpx; text-align: center; }
.stats-date-hint { margin-left: auto; color: #9aa7b2; font-size: 19rpx; }
.stats-overview { padding: 26rpx; margin-bottom: 20rpx; border-radius: 22rpx; background: linear-gradient(135deg,#f9fcfa,#e8f6ee); }
.stats-overview-title { color: #183a32; font-size: 29rpx; font-weight: 750; }
.stats-overview-title text { display: block; margin-top: 7rpx; color: #799285; font-size: 20rpx; font-weight: 400; }
.stats-amounts, .stats-group-money { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 10rpx; margin-top: 23rpx; }
.stats-amounts view, .stats-group-money view { min-width: 0; }
.stats-amounts view > text:first-child, .stats-group-money view > text:first-child { display: block; color: #8a99a5; font-size: 19rpx; }
.stats-amount { display: block; margin-top: 7rpx; color: #233a4b; font-size: 25rpx; font-weight: 750; word-break: break-all; }
.stats-amount.return-amount { color: #d6463f; font-size: 31rpx; font-weight: 850; }
.stats-amount.positive, .stats-source-money .positive { color: #d6463f; }
.stats-amount.negative, .stats-source-money .negative { color: #3a9966; font-size: 22rpx; font-weight: 500; }
.stats-overview-foot, .stats-group-foot { margin-top: 19rpx; padding-top: 13rpx; border-top: 1rpx solid #deebe4; color: #738a7e; font-size: 20rpx; line-height: 1.5; }
.stats-group { padding: 23rpx 26rpx; margin-bottom: 16rpx; border-radius: 20rpx; }
.stats-group-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.stats-group-title { color: #20384b; font-size: 28rpx; font-weight: 750; word-break: break-all; }
.stats-group-count { margin-top: 7rpx; color: #8d9aab; font-size: 20rpx; }
.stats-arrow { flex-shrink: 0; color: #25866a; font-size: 20rpx; }
.stats-group-money { margin-top: 17rpx; }
.stats-sources { margin-top: 19rpx; padding-top: 17rpx; border-top: 1rpx solid #e7eeeb; }
.stats-sources-title { color: #587267; font-size: 21rpx; font-weight: 700; }
.stats-source-row { padding: 17rpx 0; border-bottom: 1rpx solid #edf1ef; }
.stats-source-row:last-child { border-bottom: none; }
.stats-source-name { color: #304b58; font-size: 23rpx; font-weight: 700; }
.stats-source-count { margin-left: 12rpx; color: #8e9aa5; font-size: 19rpx; }
.stats-source-money { margin-top: 7rpx; color: #6f8290; font-size: 20rpx; }
.stats-source-money text { margin-left: 12rpx; font-weight: 700; }
.stats-source-money .return-inline { color: #d6463f; font-size: 24rpx; font-weight: 800; }
.stats-source-gain { margin-top: 5rpx; color: #90a0ac; font-size: 19rpx; }
.profit-inline { margin-right: 18rpx; color: #d6463f; }
.loss-muted { color: #3a9966; font-size: .92em; font-weight: 400; }
.stats-overview-foot > text + text, .stats-group-foot > text + text, .stats-source-gain > text + text { margin-left: 18rpx; }
.stats-footnote { margin: 20rpx 12rpx 30rpx; color: #97a3b1; font-size: 20rpx; line-height: 1.6; }
.tool-entry { display: flex; align-items: center; padding: 28rpx; }
.tool-symbol { display: flex; width: 100rpx; height: 100rpx; align-items: center; justify-content: center; border-radius: 24rpx; background: #eaf7f3; font-size: 54rpx; }
.entry-copy { flex: 1; margin-left: 24rpx; }
.entry-title { font-size: 30rpx; font-weight: 650; }
.entry-description { margin-top: 8rpx; color: #8793a8; font-size: 22rpx; }
.entry-arrow { color: #a0acbc; font-size: 42rpx; }
.tool-tabs { display: flex; flex-wrap: wrap; gap: 12rpx; }
.plan-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.source-manage { flex-shrink: 0; padding: 14rpx 20rpx; border: 1rpx solid #cce2d8; border-radius: 99rpx; color: #25866a; background: #fff; font-size: 22rpx; }
.tool-tab { padding: 14rpx 24rpx; border-radius: 99rpx; background: #edf1f7; color: #78869b; font-size: 24rpx; }
.tool-tab.selected { color: #25866a; background: #dff3eb; }
.list-heading { display: flex; justify-content: space-between; margin: 24rpx 4rpx 16rpx; color: #8793a8; font-size: 21rpx; }
.period-search { margin-top: 22rpx; height: 76rpx; box-sizing: border-box; padding: 0 22rpx; background: #fff; border: 1rpx solid #e4eaf1; border-radius: 18rpx; font-size: 25rpx; }
.period-group { margin-bottom: 20rpx; }
.period-heading { padding: 26rpx; display: flex; align-items: center; justify-content: space-between; }
.period-name { color: #25866a; font-size: 30rpx; font-weight: 650; }
.period-count { margin-left: 20rpx; color: #99a4b5; font-size: 22rpx; }
.period-actions { display: flex; align-items: center; gap: 22rpx; }
.period-check { padding: 10rpx 16rpx; border-radius: 99rpx; background: #fff1ef; color: #d6463f; font-size: 20rpx; }
.period-check.checking { background: #f1f3f6; color: #9ca6b2; }
.period-arrow { color: #8793a8; font-size: 22rpx; }
.period-group .plan-card { margin-top: 16rpx; }
.check-link { color: #25866a; font-size: 20rpx; flex-shrink: 0; }
.check-link.checking { color: #99a4b5; }
.check-summary { margin: 0 0 20rpx; padding: 20rpx 24rpx; border-radius: 16rpx; font-size: 22rpx; line-height: 1.6; }
.check-summary.terminal { background: #fff5f3; color: #a94b45; }
.check-summary.waiting { background: #f3f5f8; color: #66778c; }
.check-status { font-size: 27rpx; font-weight: 750; }
.check-prize { color: #d74639; font-size: 42rpx; font-weight: 800; letter-spacing: 1rpx; }
.check-score { margin-top: 5rpx; font-size: 21rpx; }
.check-summary.outcome-won { border: 1rpx solid #f1b8b2; background: linear-gradient(135deg,#fff4f1,#ffe8e4); }
.check-summary.outcome-won .check-status { color: #d63f38; font-size: 31rpx; }
.check-summary.outcome-won .check-prize { color: #d63f38; font-size: 50rpx; }
.check-summary.outcome-lost { padding: 10rpx 0 4rpx; border-top: 1rpx solid #edf0f3; border-radius: 0; background: transparent; color: #98a2ad; }
.check-summary.outcome-lost .check-status { font-size: 20rpx; font-weight: 600; }
.check-summary.outcome-lost .plan-time { font-size: 18rpx; }
.check-summary.outcome-refund { background: #fff8ee; color: #a97843; }
.empty { padding: 64rpx 28rpx; text-align: center; }
.empty-symbol { color: #8ebbaa; font-size: 62rpx; }
.empty-title { margin-top: 16rpx; font-size: 28rpx; font-weight: 650; }
.empty-description { margin-top: 12rpx; color: #8793a8; font-size: 22rpx; }
.plan-card { margin-bottom: 20rpx; padding: 26rpx; border-radius: 24rpx; box-shadow: 0 10rpx 30rpx rgba(39,63,82,.055); }
.plan-head { display: flex; gap: 16rpx; align-items: center; justify-content: space-between; }
.plan-source-inline { display: flex; flex: 1; min-width: 0; align-items: center; gap: 8rpx; color: #8c99a7; font-size: 20rpx; }
.source-label { flex-shrink: 0; }
.source-value { min-width: 0; overflow: hidden; color: #405465; font-weight: 650; white-space: nowrap; text-overflow: ellipsis; }
.plan-actions { display: flex; flex-shrink: 0; align-items: center; }
.plan-main-actions { display: flex; align-items: center; gap: 14rpx; padding-right: 18rpx; }
.delete-link { flex-shrink: 0; padding-left: 16rpx; border-left: 1rpx solid #e7ebf0; color: #9ba6b6; font-size: 20rpx; }
.detail-link { color: #25866a; font-size: 20rpx; flex-shrink: 0; }
.edit-link { color: #25866a; font-size: 20rpx; flex-shrink: 0; }
.edit-link.checking { color: #99a4b5; }
.plan-time { margin-top: 8rpx; color: #99a4b5; font-size: 20rpx; }
.plan-preview-trigger { margin-top: 16rpx; }
.purchase-inline { display: flex; height: 36rpx; align-items: center; gap: 2rpx; color: #68788a; }
.purchase-switch { width: 72rpx; transform: scale(.62); transform-origin: center; }
.plan-source { display: flex; justify-content: space-between; gap: 16rpx; margin-top: 12rpx; color: #78869b; font-size: 22rpx; }
.plan-source text:first-child { min-width: 0; word-break: break-all; }
.source-edit { flex-shrink: 0; color: #25866a; }
.plan-overview { margin: 22rpx 0; padding: 22rpx; border-radius: 18rpx; background: linear-gradient(135deg,#fafcfb,#f1f7f4); }
.overview-money { display: flex; gap: 22rpx; align-items: flex-start; justify-content: space-between; }
.overview-money > view { flex: 1; min-width: 0; }
.return-overview { text-align: right; }
.overview-label { display: block; color: #8795a7; font-size: 20rpx; }
.overview-value { display: block; margin-top: 7rpx; color: #d8443e; font-size: 31rpx; font-weight: 800; word-break: break-all; }
.overview-value.return { color: #cf3f3a; font-size: 27rpx; }
.overview-facts { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; margin-top: 20rpx; padding-top: 17rpx; border-top: 1rpx solid #dfeae5; color: #718075; font-size: 20rpx; }
.fact-edit { display: flex; min-height: 50rpx; align-items: center; gap: 7rpx; padding: 0 11rpx; border: 1rpx solid #eadfda; border-radius: 10rpx; background: #fffaf8; }
.fact-pass-edit { flex: 1; min-width: 180rpx; }
.fact-label { flex-shrink: 0; color: #8a96a3; font-size: 17rpx; }
.fact-arrow { margin-left: auto; color: #d97d72; font-size: 27rpx; }
.fact-value { margin-right: 5rpx; color: #20384a; font-size: 27rpx; font-weight: 750; }
.fact-value.warm { color: #e48031; }
.fact-pass { min-width: 0; font-size: 21rpx; line-height: 1.35; word-break: break-all; }
.match-list { border-top: 1rpx solid #e7ecef; }
.plan-card .simulation-choice-box { margin-left: auto; margin-right: auto; }
.plan-card .simulation-choice-cell { border-color: #ffd1cd; background: #fff4f2; color: #d94941; font-weight: 700; }
.plan-card .simulation-choice-cell.result-won, .saved-preview-dialog .simulation-choice-cell.result-won { border-color: #d73f38; background: #d73f38; color: #fff; box-shadow: 0 5rpx 12rpx rgba(215,63,56,.18); }
.plan-card .simulation-choice-cell.result-lost, .saved-preview-dialog .simulation-choice-cell.result-lost { border-color: #f4dedb; background: #fff9f8; color: #c4aaa7; opacity: .5; }
.plan-card .simulation-choice-cell.result-void, .saved-preview-dialog .simulation-choice-cell.result-void { border-color: #e1e5e9; background: #f3f5f7; color: #8995a2; }
.match-row { padding: 22rpx 0 4rpx; }
.match-row + .match-row { margin-top: 12rpx; border-top: 1rpx solid #edf0f2; }
.match-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.match-identity { display: flex; flex-shrink: 0; flex-direction: column; gap: 4rpx; }
.league-name { color: #426b9d; font-size: 21rpx; font-weight: 750; }
.match-number { color: #8390a0; font-size: 20rpx; }
.match-versus { display: grid; min-width: 0; flex: 1; grid-template-columns: minmax(0,1fr) auto minmax(0,1fr); align-items: center; gap: 10rpx; color: #22354c; font-size: 23rpx; font-weight: 700; text-align: center; }
.match-versus text:first-child { text-align: right; }
.match-versus text:last-child { text-align: left; }
.match-kickoff { color: #9aa4b1; font-size: 19rpx; font-weight: 400; }
.match-enter { display: flex; width: 44rpx; height: 50rpx; flex-shrink: 0; align-items: center; justify-content: flex-end; color: #d6463f; font-size: 38rpx; font-weight: 400; }
.match-title { font-size: 23rpx; word-break: break-all; }
.match-date { margin-top: 5rpx; color: #a1abb7; font-size: 18rpx; text-align: right; }
.plan-note { margin-top: 20rpx; padding: 16rpx; border-radius: 12rpx; background: #f7f9fc; color: #78869b; font-size: 22rpx; white-space: pre-wrap; }
.local-note { margin-top: 26rpx; color: #99a4b5; font-size: 20rpx; line-height: 1.6; text-align: center; }
.saved-preview-mask { position: fixed; inset: 0; z-index: 100; display: flex; align-items: center; justify-content: center; padding: 28rpx; box-sizing: border-box; background: rgba(20,35,50,.42); }
.saved-preview-dialog { width: 100%; max-height: 78vh; overflow: hidden; transform: translateY(-5vh); border-radius: 24rpx; background: #fff; box-shadow: 0 18rpx 60rpx rgba(20,35,50,.18); }
.saved-preview-head { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 22rpx; background: #fff7f6; color: #283b4d; font-size: 28rpx; font-weight: 700; }
.saved-preview-head text:last-child { padding: 0 6rpx; color: #9aa7b7; font-size: 39rpx; font-weight: 400; }
.saved-preview-content { max-height: 53vh; }
.saved-preview-match { padding: 14rpx 18rpx; border-top: 1rpx solid #edf1f5; color: #263b4e; text-align: center; font-size: 23rpx; line-height: 1.45; word-break: break-all; }
.saved-preview-dialog .simulation-choice-box { margin-top: 8rpx; gap: 10rpx; }
.saved-preview-dialog .simulation-choice-cell { padding: 9rpx 7rpx; border-color: #d6463f; background: #d6463f; color: #fff; font-size: 21rpx; font-weight: 700; line-height: 1.45; }
.saved-preview-summary { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10rpx; padding: 14rpx 18rpx 16rpx; border-top: 1rpx solid #edf1f5; background: #fff; }
.saved-preview-summary view { display: flex; min-width: 0; min-height: 82rpx; box-sizing: border-box; flex-direction: column; align-items: center; justify-content: center; padding: 11rpx 13rpx; border-radius: 12rpx; background: #fff7f6; text-align: center; }
.saved-preview-summary text { display: block; color: #929dab; font-size: 18rpx; line-height: 1.4; }
.saved-preview-summary .saved-preview-value { display: block; margin-top: 4rpx; overflow: visible; color: #d6463f; font-size: 22rpx; font-weight: 700; line-height: 1.4; word-break: break-all; white-space: normal; }
.terms-mask { position: fixed; inset: 0; z-index: 110; display: flex; align-items: flex-end; background: rgba(20,35,50,.42); }
.terms-sheet { width: 100%; box-sizing: border-box; padding: 24rpx 24rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 0 0; background: #fff; }
.terms-head { display: flex; align-items: center; justify-content: space-between; color: #25384b; font-size: 30rpx; font-weight: 750; }
.terms-head text:last-child { padding: 0 8rpx; color: #9ca7b3; font-size: 42rpx; font-weight: 400; }
.terms-label { margin: 22rpx 0 11rpx; color: #68788a; font-size: 21rpx; font-weight: 650; }
.terms-multiplier { display: flex; align-items: center; padding: 0 18rpx; border: 1rpx solid #e2e8ee; border-radius: 13rpx; background: #f8fafc; }
.terms-multiplier input { flex: 1; height: 74rpx; color: #d6463f; font-size: 29rpx; font-weight: 750; }
.terms-multiplier > text { color: #8290a0; font-size: 22rpx; }
.terms-quick-scroll { margin-top: 12rpx; white-space: nowrap; }
.terms-quick { display: flex; width: max-content; gap: 9rpx; padding-bottom: 3rpx; }
.terms-quick-item { padding: 10rpx 17rpx; border-radius: 99rpx; background: #f0f3f6; color: #718093; font-size: 20rpx; }
.terms-quick-item.active { background: #fff0ee; color: #d6463f; font-weight: 700; }
.terms-passes { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 10rpx; }
.terms-pass { padding: 15rpx 4rpx; border: 1rpx solid #e3e8ed; border-radius: 11rpx; color: #718093; text-align: center; font-size: 21rpx; }
.terms-pass.active { border-color: #d6463f; background: #fff0ee; color: #d6463f; font-weight: 700; }
.terms-summary { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10rpx; margin-top: 20rpx; padding: 16rpx; border-radius: 14rpx; background: #f7f9fb; }
.terms-summary view { min-width: 0; }
.terms-summary text { display: block; color: #8995a3; font-size: 18rpx; }
.terms-summary text:last-child { margin-top: 4rpx; color: #d6463f; font-size: 23rpx; font-weight: 750; word-break: break-all; }
.terms-summary .terms-return { grid-column: 1 / -1; padding-top: 10rpx; border-top: 1rpx solid #e9edf1; }
.terms-error { margin-top: 14rpx; color: #c45c52; font-size: 20rpx; text-align: center; }
.terms-save { margin-top: 20rpx; border-radius: 14rpx; background: #d6463f; color: #fff; font-size: 24rpx; line-height: 78rpx; }
.terms-save[disabled] { background: #e8ebef; color: #a7b0bb; }
.terms-save::after { border: none; }
.source-mask { position: fixed; inset: 0; z-index: 80; display: flex; align-items: flex-end; background: rgba(20,35,50,.42); }
.source-dialog { width: 100%; box-sizing: border-box; padding: 26rpx 26rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 0 0; background: #fff; }
.source-heading { display: flex; align-items: center; justify-content: space-between; font-size: 31rpx; font-weight: 650; }
.source-close { padding: 0 8rpx; color: #98a3b3; font-size: 42rpx; }
.source-hint { margin: 10rpx 0 20rpx; color: #98a3b3; font-size: 21rpx; }
.source-list { height: 360rpx; max-height: 40vh; }
.source-list.empty-list { height: 150rpx; }
.source-item { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 18rpx 20rpx; margin-bottom: 10rpx; border: 1rpx solid #e7edf1; border-radius: 14rpx; color: #25344a; font-size: 24rpx; }
.source-item.chosen { border-color: #72b9a0; background: #eaf7f2; color: #25866a; }
.source-name { font-weight: 600; }
.source-id { margin-top: 6rpx; color: #99a4b5; font-size: 18rpx; word-break: break-all; }
.source-choice { flex-shrink: 0; color: #25866a; font-size: 21rpx; }
.source-empty { padding: 48rpx 0; text-align: center; color: #99a4b5; font-size: 22rpx; }
.source-add { display: flex; align-items: center; gap: 12rpx; margin-top: 18rpx; }
.source-add input { flex: 1; min-width: 0; height: 74rpx; padding: 0 18rpx; border-radius: 14rpx; background: #f4f7fa; font-size: 24rpx; }
.source-add button { flex-shrink: 0; margin: 0; padding: 0 28rpx; border-radius: 14rpx; background: #25866a; color: #fff; font-size: 23rpx; line-height: 74rpx; }
.source-add button::after { border: none; }
