<view class="page simulation-page">
  <view class="intro"><view class="intro-title">模拟计算</view><view class="intro-subtitle">记录自己的赛事选择，结合赛果复盘</view></view>
  <view class="tabs card">
    <view class="tab {{activeTab === 'collection' ? 'active' : ''}}" data-tab="collection" bindtap="selectTab">模拟集合</view>
    <view class="tab {{activeTab === 'plans' ? 'active' : ''}}" data-tab="plans" bindtap="selectTab">我的方案</view>
    <view class="tab {{activeTab === 'stats' ? 'active' : ''}}" data-tab="stats" bindtap="selectTab">盈亏</view>
  </view>
  <block wx:if="{{activeTab === 'collection'}}">
    <view wx:for="{{tools}}" wx:key="id" class="tool-entry card" data-id="{{item.id}}" bindtap="openTool">
      <view class="tool-symbol">{{item.symbol}}</view><view class="entry-copy"><view class="entry-title">{{item.name}}</view><view class="entry-description">{{item.description}}</view></view><text class="entry-arrow">›</text>
    </view>
  </block>
  <block wx:elif="{{activeTab === 'stats'}}">
    <view class="stats-note">仅统计已标记“实际购买”的方案。总投入包含待核对方案；盈亏仅按已完成核对的方案计算。</view>
    <view class="tool-tabs stats-tools"><view wx:for="{{tools}}" wx:key="id" class="tool-tab {{selectedToolId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectTool">{{item.symbol}} {{item.name}}</view></view>
    <view class="stats-switch card"><view class="stats-switch-item {{statsDimension === 'period' ? 'selected' : ''}}" data-dimension="period" bindtap="selectStatsDimension">按期号</view><view class="stats-switch-item {{statsDimension === 'source' ? 'selected' : ''}}" data-dimension="source" bindtap="selectStatsDimension">按来源</view></view>
    <view class="stats-filters"><picker mode="selector" range="{{statsYearOptions}}" range-key="label" value="{{statsYearIndex}}" bindchange="changeStatsYear"><view class="stats-filter">{{statsYearOptions[statsYearIndex].label}} ⌄</view></picker><picker mode="selector" range="{{statsMonthOptions}}" range-key="label" value="{{statsMonthIndex}}" bindchange="changeStatsMonth"><view class="stats-filter">{{statsMonthOptions[statsMonthIndex].label}} ⌄</view></picker><text class="stats-date-hint">按期号日期</text></view>
    <view wx:if="{{statsError}}" class="empty card">{{statsError}}</view>
    <block wx:elif="{{statsSummary}}">
      <view class="stats-overview card"><view class="stats-overview-title">{{statsDimension === 'period' ? '期号汇总' : '来源汇总'}} <text>{{statsSummary.planCount}} 个方案 · 已核对 {{statsSummary.checkedCount}} 个 · 命中 {{statsSummary.wonCount}} 个</text></view><view class="stats-amounts"><view><text>总投入</text><text class="stats-amount">¥{{statsSummary.cost}}</text></view><view><text>已核对回报</text><text class="stats-amount">¥{{statsSummary.returned}}</text></view><view><text>已核对净额</text><text class="stats-amount {{statsSummary.netPositive ? 'positive' : 'negative'}}">{{statsSummary.netPositive ? '+' : ''}}¥{{statsSummary.net}}</text></view></view><view class="stats-overview-foot">盈利 ¥{{statsSummary.profit}} · 亏损 ¥{{statsSummary.loss}}<text wx:if="{{statsSummary.pendingCount}}"> · 待核对 {{statsSummary.pendingCount}} 个 / ¥{{statsSummary.pendingCost}}</text></view></view>
      <view wx:if="{{!statsGroups.length}}" class="empty card">当前筛选下没有已标记实际购买的方案</view>
      <view wx:for="{{statsGroups}}" wx:for-item="group" wx:key="id" class="stats-group card">
        <view class="stats-group-head" data-id="{{group.id}}" data-source="{{group.sourceId}}" bindtap="openStatsGroup"><view><view class="stats-group-title">{{group.label}}</view><view class="stats-group-count">{{group.summary.planCount}} 个方案 · 命中 {{group.summary.wonCount}} 个<text wx:if="{{group.summary.pendingCount}}"> · 待核对 {{group.summary.pendingCount}} 个</text></view></view><text class="stats-arrow">{{statsDimension === 'period' ? group.expanded ? '收起 ⌃' : '来源明细 ⌄' : '日期明细 ›'}}</text></view>
        <view class="stats-group-money"><view><text>投入</text><text class="stats-amount">¥{{group.summary.cost}}</text></view><view><text>回报</text><text class="stats-amount">¥{{group.summary.returned}}</text></view><view><text>净额</text><text class="stats-amount {{group.summary.netPositive ? 'positive' : 'negative'}}">{{group.summary.netPositive ? '+' : ''}}¥{{group.summary.net}}</text></view></view>
        <view class="stats-group-foot">盈利 ¥{{group.summary.profit}} · 亏损 ¥{{group.summary.loss}}</view>
        <view wx:if="{{statsDimension === 'period' && group.expanded}}" class="stats-sources"><view class="stats-sources-title">本期来源</view><view wx:for="{{group.sources}}" wx:for-item="source" wx:key="id" class="stats-source-row"><view><text class="stats-source-name">{{source.label}}</text><text class="stats-source-count">{{source.summary.planCount}} 个方案 · 命中 {{source.summary.wonCount}} 个<text wx:if="{{source.summary.pendingCount}}"> · 待核对 {{source.summary.pendingCount}} 个</text></text></view><view class="stats-source-money">投入 ¥{{source.summary.cost}} · 回报 ¥{{source.summary.returned}}<text class="{{source.summary.netPositive ? 'positive' : 'negative'}}">净额 {{source.summary.netPositive ? '+' : ''}}¥{{source.summary.net}}</text></view><view class="stats-source-gain">盈利 ¥{{source.summary.profit}} · 亏损 ¥{{source.summary.loss}}</view></view></view>
      </view>
      <view wx:if="{{statsDimension === 'period'}}" class="stats-footnote">比赛按所属期号统计，不按开赛日期。新方案只允许同一期号；历史跨期记录按最早期号归档，不重复计算。</view>
      <view wx:else class="stats-footnote">点击来源，可按期号日期查看年、月、日及当天的每个方案。</view>
    </block>
  </block>
  <block wx:else>
    <view class="simulation-notice">方案仅保存在本机，用于个人模拟与赛后复盘。金额为模拟参考值，不提供真实投注、支付、出票或兑奖。</view>
    <view class="plan-toolbar"><view class="tool-tabs"><view wx:for="{{tools}}" wx:key="id" class="tool-tab {{selectedToolId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectTool">{{item.symbol}} {{item.name}}</view></view><view class="source-manage" bindtap="openSources">来源管理</view></view>
    <input class="period-search" value="{{periodQuery}}" maxlength="20" placeholder="搜索期号，如 261012" bindinput="searchPeriod" />
    <view class="list-heading"><text>{{planGroups.length}} 期 · {{planCount}} 个方案</text><text>期号及方案时间倒序</text></view>
    <view wx:if="{{!planGroups.length}}" class="empty card"><view class="empty-symbol">▤</view><view class="empty-title">{{periodQuery ? '没有匹配的期号' : '还没有保存的方案'}}</view><view class="empty-description">在模拟工具中保存后，可以在这里回看</view></view>
    <view wx:for="{{planGroups}}" wx:for-item="periodGroup" wx:key="id" class="period-group">
      <view class="period-heading card" data-id="{{periodGroup.id}}" bindtap="togglePeriod"><view><text class="period-name">{{periodGroup.label}}</text><text class="period-count">{{periodGroup.plans.length}} 个方案</text></view><text class="period-arrow">{{periodGroup.expanded ? '收起 ⌃' : '展开 ⌄'}}</text></view>
      <block wx:if="{{periodGroup.expanded}}">
    <view wx:for="{{periodGroup.plans}}" wx:key="id" class="plan-card card">
      <view class="plan-head"><view class="plan-created"><text>保存于</text><text>{{item.createdTime}}</text></view><view class="plan-actions"><view class="plan-main-actions"><text class="check-link {{checkingId ? 'checking' : ''}}" data-id="{{item.id}}" catchtap="checkSavedPlan">{{checkingId === item.id ? '处理中…' : item.needsOdds ? '补赔率' : '核对'}}</text><text class="edit-link {{editingId ? 'checking' : ''}}" data-id="{{item.id}}" catchtap="editPlan">{{editingId === item.id ? '检查中…' : '修改'}}</text><text class="detail-link" data-id="{{item.id}}" catchtap="openDetail">明细</text></view><text class="delete-link" data-id="{{item.id}}" catchtap="deletePlan">删除</text></view></view>
      <view class="plan-subline"><text>来源：{{item.planSourceName || '未关联'}}</text><text class="source-edit" data-id="{{item.id}}" catchtap="openPlanSource">设置</text><view class="purchase-inline"><text>实际购买</text><switch class="purchase-switch" checked="{{item.purchased}}" color="#d6463f" data-id="{{item.id}}" bindchange="togglePlanPurchased" /></view></view>
      <view class="plan-overview">
        <view class="overview-money"><view><text class="overview-label">模拟投入</text><text class="overview-value accent">¥{{item.cost}}</text></view><view class="return-overview"><text class="overview-label">{{item.needsOdds ? '模拟回报区间' : item.minReturn ? '模拟回报区间' : '历史模拟回报上限'}}</text><text class="overview-value return">{{item.needsOdds ? '待赔率 / 让球数' : (item.minReturn ? '¥' + item.minReturn + ' ～ ' : '') + '¥' + item.maxReturn}}</text></view></view>
        <view class="overview-facts"><text><text class="fact-value warm">{{item.multiplier}}倍</text> 倍率</text><text class="fact-value">{{item.passLabel}}</text><text><text class="fact-value">{{item.count}}组</text> 组合</text></view>
      </view>
      <view wx:if="{{item.periodIds.length > 1}}" class="plan-time">历史跨期方案：{{item.periodLabel}}</view>
      <view wx:if="{{item.check}}" class="check-summary {{item.check.status === 'complete' ? 'terminal' : 'waiting'}}">
        <block wx:if="{{item.check.status !== 'complete'}}"><view class="check-status">比赛未结束</view><view wx:for="{{item.check.pendingScores}}" wx:for-item="score" wx:key="*this" class="check-score">{{score}}</view><view wx:if="{{!item.check.pendingScores || !item.check.pendingScores.length}}" class="check-score">暂未查到最终赛果，请稍后再核对</view></block>
        <block wx:elif="{{item.check.outcome === 'won' || !item.check.outcome && item.check.prizeAmount !== '0.00'}}"><view class="check-status">已中奖 · 模拟回报</view><view class="check-prize">¥{{item.check.prizeAmount}}</view></block>
        <block wx:elif="{{item.check.outcome === 'refund' || item.check.refundCount}}"><view class="check-status">场次无效 · 模拟返还</view><view class="check-prize">¥{{item.check.refundAmount}}</view></block>
        <view wx:else class="check-status">未中奖</view>
        <view class="plan-time">核对时间：{{item.checkedTime}}</view>
      </view>
      <view class="match-list"><view wx:for="{{item.matches}}" wx:for-item="match" wx:key="id" class="match-row"><view class="match-heading"><view class="match-identity"><text wx:if="{{match.league}}" class="league-name">{{match.league}}</text><text class="match-number">{{match.number || match.numberCode}}</text></view><view wx:if="{{match.home || match.away}}" class="match-versus"><text>{{match.home}}</text><text class="match-kickoff">{{match.time || 'vs'}}</text><text>{{match.away}}</text></view></view><view wx:if="{{!match.home && !match.away}}" class="match-title">{{match.label}}</view><view wx:if="{{match.date}}" class="match-date">{{match.date}}</view><view class="simulation-choice-box columns-{{match.selectionRows[0].columns}}"><view wx:for="{{match.selectionRows}}" wx:for-item="row" wx:key="id" class="simulation-choice-row"><text wx:for="{{row.options}}" wx:for-item="choice" wx:key="key" class="simulation-choice-cell">{{choice.text}}</text></view></view></view></view>
      <view class="plan-time">官方数据更新：{{item.sourceUpdatedAt}} · {{item.needsOdds ? '部分赔率或让球数待公布，可随后补全' : item.pricingNote || '保存时赔率快照'}}</view>
      <view wx:if="{{item.note}}" class="plan-note">{{item.note}}</view>
    </view>
      </block>
    </view>
  </block>
  <view class="local-note">方案保存在当前设备，清理缓存或删除小程序可能导致记录丢失。</view>
  <view wx:if="{{sourceVisible}}" class="source-mask" catchtap="closeSources">
    <view class="source-dialog" catchtap="stopPropagation">
      <view class="source-heading"><text>{{editingPlanId ? '设置方案来源' : '来源管理'}}</text><text class="source-close" catchtap="closeSources">×</text></view>
      <view class="source-hint">每个来源都有独立 ID，关联到方案后便于后续统计。</view>
      <scroll-view class="source-list {{sources.length ? '' : 'empty-list'}}" scroll-y="true">
        <view wx:if="{{editingPlanId}}" class="source-item {{!currentSourceId ? 'chosen' : ''}}" data-id="" catchtap="chooseSource"><text>不关联来源</text></view>
        <view wx:for="{{sources}}" wx:key="id" class="source-item {{editingPlanId && currentSourceId === item.id ? 'chosen' : ''}}" data-id="{{item.id}}" catchtap="chooseSource"><view><view class="source-name">{{item.name}}</view><view class="source-id">ID：{{item.id}}</view></view><text wx:if="{{editingPlanId}}" class="source-choice">{{currentSourceId === item.id ? '已关联' : '选择'}}</text></view>
        <view wx:if="{{!sources.length}}" class="source-empty">还没有来源，可在下方添加。</view>
      </scroll-view>
      <view class="source-add"><input maxlength="40" value="{{newSourceName}}" placeholder="输入来源名称" bindinput="setNewSourceName" /><button bindtap="addSource">添加</button></view>
    </view>
  </view>
</view>
