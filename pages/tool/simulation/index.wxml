<view class="page simulation-page">
  <view class="intro"><view class="intro-title">模拟计算</view><view class="intro-subtitle">记录自己的赛事选择，结合赛果复盘</view></view>
  <view class="tabs card">
    <view class="tab {{activeTab === 'collection' ? 'active' : ''}}" data-tab="collection" bindtap="selectTab">模拟集合</view>
    <view class="tab {{activeTab === 'plans' ? 'active' : ''}}" data-tab="plans" bindtap="selectTab">我的方案</view>
  </view>
  <block wx:if="{{activeTab === 'collection'}}">
    <view wx:for="{{tools}}" wx:key="id" class="tool-entry card" data-id="{{item.id}}" bindtap="openTool">
      <view class="tool-symbol">{{item.symbol}}</view><view class="entry-copy"><view class="entry-title">{{item.name}}</view><view class="entry-description">{{item.description}}</view></view><text class="entry-arrow">›</text>
    </view>
  </block>
  <block wx:else>
    <view class="simulation-notice">方案仅保存在本机，用于个人模拟与赛后复盘。金额为模拟参考值，不提供真实投注、支付、出票或兑奖。</view>
    <view class="plan-toolbar"><view class="tool-tabs"><view wx:for="{{tools}}" wx:key="id" class="tool-tab {{selectedToolId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectTool">{{item.symbol}} {{item.name}}</view></view><view class="source-manage" bindtap="openSources">来源管理</view></view>
    <input class="period-search" value="{{periodQuery}}" maxlength="20" placeholder="搜索期号，如 261012" bindinput="searchPeriod" />
    <view class="list-heading"><text>{{planGroups.length}} 期 · {{planCount}} 个方案</text><text>期号及方案时间倒序</text></view>
    <view wx:if="{{!planGroups.length}}" class="empty card"><view class="empty-symbol">▤</view><view class="empty-title">{{periodQuery ? '没有匹配的期号' : '还没有保存的方案'}}</view><view class="empty-description">在模拟工具中保存后，可以在这里回看</view></view>
    <view wx:for="{{planGroups}}" wx:for-item="periodGroup" wx:key="id" class="period-group">
      <view class="period-heading card" data-id="{{periodGroup.id}}" bindtap="togglePeriod"><view><text class="period-name">{{periodGroup.label}}</text><text class="period-count">{{periodGroup.plans.length}} 个方案</text></view><text class="period-arrow">{{periodGroup.expanded ? '收起 ⌃' : '展开 ⌄'}}</text></view>
      <block wx:if="{{periodGroup.expanded}}">
    <view wx:for="{{periodGroup.plans}}" wx:key="id" class="plan-card card">
      <view class="plan-head"><view class="plan-title">{{item.title}}</view><text class="check-link {{checkingId ? 'checking' : ''}}" data-id="{{item.id}}" catchtap="checkSavedPlan">{{checkingId === item.id ? '核对中…' : '核对'}}</text><text class="detail-link" data-id="{{item.id}}" catchtap="openDetail">明细</text><text class="delete-link" data-id="{{item.id}}" catchtap="deletePlan">删除</text></view>
      <view class="plan-subline"><text>{{item.createdTime}}</text><text>来源：{{item.planSourceName || '未关联'}}</text><text class="source-edit" data-id="{{item.id}}" catchtap="openPlanSource">设置</text></view>
      <view class="plan-overview">
        <view class="overview-money"><view><text class="overview-label">模拟投入</text><text class="overview-value accent">¥{{item.cost}}</text></view><view class="return-overview"><text class="overview-label">{{item.minReturn ? '模拟回报区间' : '历史模拟回报上限'}}</text><text class="overview-value return">{{item.minReturn ? '¥' + item.minReturn + ' ～ ' : ''}}¥{{item.maxReturn}}</text></view></view>
        <view class="overview-facts"><text><text class="fact-value warm">{{item.multiplier}}倍</text> 倍率</text><text class="fact-value">{{item.passLabel}}</text><text><text class="fact-value">{{item.count}}组</text> 组合</text></view>
      </view>
      <view wx:if="{{item.periodIds.length > 1}}" class="plan-time">跨期方案：{{item.periodLabel}}</view>
      <view wx:if="{{item.check}}" class="check-summary {{item.check.status === 'complete' ? 'terminal' : 'waiting'}}">
        <block wx:if="{{item.check.status !== 'complete'}}"><view class="check-status">比赛未结束</view><view wx:for="{{item.check.pendingScores}}" wx:for-item="score" wx:key="*this" class="check-score">{{score}}</view><view wx:if="{{!item.check.pendingScores || !item.check.pendingScores.length}}" class="check-score">暂未查到最终赛果，请稍后再核对</view></block>
        <block wx:elif="{{item.check.outcome === 'won' || !item.check.outcome && item.check.prizeAmount !== '0.00'}}"><view class="check-status">已中奖 · 模拟回报</view><view class="check-prize">¥{{item.check.prizeAmount}}</view></block>
        <block wx:elif="{{item.check.outcome === 'refund' || item.check.refundCount}}"><view class="check-status">场次无效 · 模拟返还</view><view class="check-prize">¥{{item.check.refundAmount}}</view></block>
        <view wx:else class="check-status">未中奖</view>
        <view class="plan-time">核对时间：{{item.checkedTime}}</view>
      </view>
      <view class="match-list"><view wx:for="{{item.matches}}" wx:for-item="match" wx:key="id" class="match-row"><view class="match-heading"><view class="match-identity"><text wx:if="{{match.league}}" class="league-name">{{match.league}}</text><text class="match-number">{{match.number || match.numberCode}}</text></view><view wx:if="{{match.home || match.away}}" class="match-versus"><text>{{match.home}}</text><text class="match-kickoff">{{match.time || 'vs'}}</text><text>{{match.away}}</text></view></view><view wx:if="{{!match.home && !match.away}}" class="match-title">{{match.label}}</view><view wx:if="{{match.date}}" class="match-date">{{match.date}}</view><view class="simulation-choice-box columns-{{match.selectionRows[0].columns}}"><view wx:for="{{match.selectionRows}}" wx:for-item="row" wx:key="id" class="simulation-choice-row"><text wx:for="{{row.options}}" wx:for-item="choice" wx:key="key" class="simulation-choice-cell">{{choice.text}}</text></view></view></view></view>
      <view class="plan-time">官方数据更新：{{item.sourceUpdatedAt}} · 保存时赔率快照</view>
      <view wx:if="{{item.note}}" class="plan-note">{{item.note}}</view>
    </view>
      </block>
    </view>
  </block>
  <view class="local-note">方案保存在当前设备，清理缓存或删除小程序可能导致记录丢失。</view>
  <view wx:if="{{sourceVisible}}" class="source-mask" catchtap="closeSources">
    <view class="source-dialog" catchtap="stopPropagation">
      <view class="source-heading"><text>{{editingPlanId ? '设置方案来源' : '来源管理'}}</text><text class="source-close" catchtap="closeSources">×</text></view>
      <view class="source-hint">每个来源都有独立 ID，关联到方案后便于后续统计。</view>
      <scroll-view class="source-list {{sources.length ? '' : 'empty-list'}}" scroll-y="true">
        <view wx:if="{{editingPlanId}}" class="source-item {{!currentSourceId ? 'chosen' : ''}}" data-id="" catchtap="chooseSource"><text>不关联来源</text></view>
        <view wx:for="{{sources}}" wx:key="id" class="source-item {{editingPlanId && currentSourceId === item.id ? 'chosen' : ''}}" data-id="{{item.id}}" catchtap="chooseSource"><view><view class="source-name">{{item.name}}</view><view class="source-id">ID：{{item.id}}</view></view><text wx:if="{{editingPlanId}}" class="source-choice">{{currentSourceId === item.id ? '已关联' : '选择'}}</text></view>
        <view wx:if="{{!sources.length}}" class="source-empty">还没有来源，可在下方添加。</view>
      </scroll-view>
      <view class="source-add"><input maxlength="40" value="{{newSourceName}}" placeholder="输入来源名称" bindinput="setNewSourceName" /><button bindtap="addSource">添加</button></view>
    </view>
  </view>
</view>
