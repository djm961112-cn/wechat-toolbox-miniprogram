@import "../choices.wxss";
.football-page { padding: 24rpx 22rpx calc(340rpx + env(safe-area-inset-bottom)); }
.source-head { display: flex; gap: 14rpx; justify-content: space-between; align-items: center; }
.heading { font-size: 36rpx; font-weight: 700; }
.source-note { margin-top: 8rpx; color: #8b97a9; font-size: 19rpx; }
.simulation-notice { margin-top: 18rpx; padding: 16rpx 20rpx; border-radius: 14rpx; background: #fff0ee; color: #a35750; font-size: 20rpx; line-height: 1.5; }
.draft-notice { margin-top: 12rpx; padding: 16rpx 20rpx; border-radius: 14rpx; background: #fff6e8; color: #9b6d38; font-size: 20rpx; line-height: 1.5; }
.refresh { flex-shrink: 0; color: #d6463f; font-size: 24rpx; padding: 10rpx; }
.market-scroll { position: sticky; z-index: 18; top: 0; margin-top: 12rpx; padding-top: 12rpx; background: #f4f7fc; }
.markets { display: flex; width: max-content; gap: 12rpx; padding-bottom: 12rpx; }
.market { flex-shrink: 0; padding: 14rpx 22rpx; border-radius: 99rpx; color: #77849a; background: #eaf0f6; font-size: 23rpx; }
.market.active { color: #fff; background: #d6463f; }
.selection-heading { display: flex; justify-content: space-between; margin: 16rpx 4rpx 20rpx; color: #8b97a9; font-size: 21rpx; }
.state { padding: 54rpx 26rpx; color: #8793a8; font-size: 25rpx; text-align: center; line-height: 1.7; }
.empty-match-symbol { margin-bottom: 12rpx; font-size: 54rpx; opacity: .52; }
.retry { margin-top: 20rpx; color: #d6463f; background: #fff0ee; font-size: 24rpx; }
.match-card { padding: 14rpx; margin-bottom: 12rpx; border-radius: 18rpx; }
.match-compact-head { display: grid; grid-template-columns: 148rpx minmax(0,1fr) 70rpx; align-items: center; gap: 10rpx; margin-bottom: 10rpx; }
.match-info { min-width: 0; color: #8b97a9; }
.match-tags { display: flex; align-items: center; flex-wrap: wrap; gap: 5rpx; }
.match-number { color: #34495b; font-size: 20rpx; font-weight: 750; }
.match-league { padding: 3rpx 7rpx; border-radius: 5rpx; background: #fff0ee; color: #d6463f; font-size: 16rpx; }
.match-period, .match-time { display: block; margin-top: 4rpx; font-size: 16rpx; line-height: 1.3; word-break: break-all; }
.compact-teams { display: grid; min-width: 0; grid-template-columns: minmax(0,1fr) auto minmax(0,1fr); align-items: center; gap: 8rpx; color: #26394c; font-size: 24rpx; font-weight: 700; text-align: center; word-break: break-all; }
.compact-teams text:first-child { text-align: right; }
.compact-teams text:last-child { text-align: left; }
.versus { color: #a8b3c2; font-size: 18rpx; font-weight: 400; }
.match-tools { display: flex; flex-direction: column; align-items: stretch; gap: 7rpx; }
.analyze-match, .copy-match, .more-match { padding: 6rpx 4rpx; border-radius: 7rpx; color: #d6463f; background: #fff2f0; font-size: 17rpx; text-align: center; }
.analyze-match { color: #fff; background: #d6463f; font-weight: 700; }
.more-match { color: #657687; background: #f1f4f7; }
.selected-note { margin: 4rpx 0 7rpx; color: #d6463f; font-size: 17rpx; }
.readonly-note { margin: 4rpx 0 7rpx; color: #a0a9b8; font-size: 18rpx; text-align: center; }
.preopen-note { margin: 4rpx 0 7rpx; padding: 7rpx 10rpx; border-radius: 8rpx; background: #fff4f1; color: #bd5b53; font-size: 17rpx; text-align: center; }
.pool + .pool { margin-top: 8rpx; }
.pool-body { display: flex; align-items: stretch; gap: 8rpx; }
.pool-body .options { flex: 1; min-width: 0; }
.pool-summary { display: flex; width: 96rpx; flex-shrink: 0; box-sizing: border-box; flex-direction: column; align-items: center; justify-content: center; padding: 5rpx; border-radius: 8rpx; background: #f3f6f9; color: #7b889a; text-align: center; }
.pool-name { font-size: 16rpx; line-height: 1.2; word-break: break-all; }
.pool-goal { margin-top: 3rpx; color: #7d8998; font-size: 20rpx; font-weight: 700; }
.pool-goal.adjusted { color: #d45a50; }
.pool-eligibility { margin-top: 3rpx; color: #a1abb6; font-size: 14rpx; }
.pool-eligibility.active { color: #d6463f; }
.pool-eligibility.pending { color: #bd7855; }
.options { display: grid; grid-template-columns: repeat(3,1fr); gap: 6rpx; }
.options.scores, .options.goals { grid-template-columns: repeat(4,1fr); }
.option { padding: 9rpx 2rpx; border: 1rpx solid #e4eaf1; border-radius: 8rpx; background: #f8fafd; text-align: center; color: #d6463f; font-size: 20rpx; font-weight: 700; }
.option text { display: block; }
.odds { margin-top: 2rpx; color: #596879; font-size: 17rpx; font-weight: 500; }
.option.chosen { background: #d6463f; border-color: #d6463f; color: #fff; }
.option.chosen .odds { color: #fff; }
.option.disabled { color: #b7c0cb; background: #f0f3f6; border-color: #edf0f4; }
.option.disabled .odds { color: #b7c0cb; }
.pass-mask { position: fixed; inset: 0; z-index: 25; background: rgba(20,35,50,.25); }
.pass-sheet { position: absolute; left: 0; right: 0; bottom: calc(228rpx + env(safe-area-inset-bottom)); padding: 24rpx; border-radius: 26rpx 26rpx 0 0; background: #fff; }
.pass-content { max-height: 36vh; }
.pass-options { display: grid; grid-template-columns: repeat(4,1fr); gap: 12rpx; }
.pass { padding: 16rpx 6rpx; text-align: center; border-radius: 12rpx; border: 1rpx solid #e4eaf1; color: #7b889a; font-size: 23rpx; }
.pass.chosen { background: #fff0ee; border-color: #e7807a; color: #d6463f; }
.pass-done { margin-top: 20rpx; padding: 17rpx; border-radius: 14rpx; text-align: center; background: #d6463f; color: #fff; font-size: 24rpx; }
.multiplier { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; min-width: 98rpx; height: 54rpx; padding: 0 12rpx; border: 1rpx solid #e4eaf1; border-radius: 12rpx; color: #d6463f; font-size: 22rpx; font-weight: 650; }
.multiplier-arrow { color: #91a0b0; font-size: 18rpx; }
.multiplier-mask { position: fixed; inset: 0; z-index: 90; display: flex; align-items: flex-end; background: rgba(20,35,50,.42); }
.multiplier-sheet { width: 100%; box-sizing: border-box; padding: 24rpx 20rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 26rpx 26rpx 0 0; background: #f4f6f8; }
.multiplier-heading { display: flex; align-items: center; justify-content: space-between; padding: 0 6rpx 20rpx; color: #25344a; font-size: 29rpx; font-weight: 650; }
.multiplier-draft { display: block; margin-top: 6rpx; color: #d6463f; font-size: 24rpx; }
.multiplier-quick { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10rpx; margin-bottom: 22rpx; }
.quick-item { padding: 20rpx 0; border: 1rpx solid #d6dee5; border-radius: 12rpx; background: #fff; color: #37485c; text-align: center; font-size: 23rpx; }
.quick-item.active { border-color: #d6463f; background: #fff0ee; color: #d6463f; }
.multiplier-keypad { display: grid; grid-template-columns: repeat(3, 1fr); gap: 9rpx; }
.multiplier-key { display: flex; height: 92rpx; align-items: center; justify-content: center; border-radius: 12rpx; background: #fff; color: #25344a; font-size: 36rpx; }
.multiplier-key.key-action { background: #e4e8ec; font-size: 29rpx; }
.multiplier-key.key-confirm { color: #d6463f; font-weight: 650; }
.reference-note { padding: 26rpx 10rpx; color: #98a3b3; font-size: 19rpx; line-height: 1.7; text-align: center; }
.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 30; height: calc(228rpx + env(safe-area-inset-bottom)); box-sizing: border-box; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #edf1f5; background: #fff; box-shadow: 0 -6rpx 24rpx rgba(41,66,111,.04); }
.bottom-controls { display: flex; align-items: center; gap: 12rpx; }
.selected-badge { flex-shrink: 0; color: #77849a; font-size: 22rpx; }
.pass-trigger { flex: 1; min-width: 0; display: flex; justify-content: space-between; align-items: center; height: 54rpx; padding: 0 16rpx; border: 1rpx solid #e4eaf1; border-radius: 12rpx; color: #d6463f; font-size: 23rpx; }
.pass-trigger text:first-child { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.pass-trigger.active { border-color: #e7807a; background: #fff0ee; }
.bottom-total { display: flex; justify-content: space-between; align-items: center; margin-top: 12rpx; height: 68rpx; }
.total-money { flex: 1; min-width: 0; }
.bottom-actions { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; }
.clear-button { flex: 0 0 100rpx; width: 100rpx; min-width: 0; box-sizing: border-box; margin: 0; padding: 17rpx 0; border: 1rpx solid #f0c0bb; border-radius: 16rpx; background: #fff3f1; color: #d6463f; font-size: 24rpx; line-height: 1.4; }
.clear-button::after { border: none; }
.clear-button[disabled] { border-color: #edf0f4; background: #f1f3f6; color: #b6bfcb; }
.count { display: block; color: #8b97a9; font-size: 20rpx; }
.cost { display: block; margin-top: 2rpx; color: #d6463f; font-size: 29rpx; font-weight: 700; }
.preview-button { padding: 17rpx 32rpx; border-radius: 16rpx; background: #d6463f; color: #fff; font-size: 24rpx; }
.prize-range { display: flex; justify-content: space-between; gap: 12rpx; margin-top: 12rpx; color: #8793a8; font-size: 20rpx; line-height: 30rpx; }
.prize-range text:first-child { flex-shrink: 0; }
.prize-range text:last-child { color: #d6463f; text-align: right; word-break: break-all; }
.floating-save { position: fixed; z-index: 20; right: 26rpx; bottom: calc(248rpx + env(safe-area-inset-bottom)); display: flex; width: 90rpx; height: 90rpx; flex-direction: column; align-items: center; justify-content: center; border-radius: 50%; color: #fff; background: #d6463f; box-shadow: 0 8rpx 24rpx rgba(214,70,63,.25); font-size: 24rpx; }
.floating-save text { margin-top: 2rpx; font-size: 18rpx; }
.preview-mask { position: fixed; z-index: 100; top: 0; bottom: 0; left: 0; right: 0; display: flex; align-items: center; justify-content: center; padding: 28rpx; box-sizing: border-box; background: rgba(20,35,50,.42); }
.sheet-heading { display: flex; justify-content: space-between; align-items: center; font-size: 31rpx; font-weight: 650; }
.close { padding: 0 8rpx; font-size: 40rpx; color: #9aa7b7; }
.form-label { margin: 18rpx 0 12rpx; color: #7b889a; font-size: 22rpx; }
.form-note { width: 100%; height: 130rpx; box-sizing: border-box; padding: 16rpx; border-radius: 14rpx; background: #f5f7fa; font-size: 23rpx; }
.save-button { margin-top: 20rpx; border-radius: 16rpx; background: #d6463f; color: #fff; font-size: 25rpx; }
.save-button::after { border: none; }
.preview-dialog { width: 100%; max-height: 85vh; overflow: hidden; transform: translateY(-5vh); border-radius: 24rpx; background: #fff; box-shadow: 0 18rpx 60rpx rgba(20,35,50,.18); }
.preview-heading { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; padding: 26rpx; background: #fff8f7; font-size: 30rpx; font-weight: 650; }
.preview-heading text:first-child { flex: 1; min-width: 0; word-break: break-all; }
.brief-content { max-height: 55vh; }
.brief-match { padding: 20rpx 22rpx; border-top: 1rpx solid #edf1f5; text-align: center; font-size: 25rpx; line-height: 1.5; word-break: break-all; }
.preview-actions { padding: 0 26rpx 24rpx; }
.save-form { max-height: 68vh; overflow-y: auto; padding: 8rpx 26rpx 22rpx; }
.source-options { width: 100%; white-space: nowrap; }
.source-options-inner { display: inline-flex; gap: 10rpx; padding: 4rpx 0; }
.source-option { flex-shrink: 0; padding: 13rpx 20rpx; border: 1rpx solid #dfe7ec; border-radius: 99rpx; color: #78869b; background: #fff; font-size: 22rpx; }
.source-option.active { border-color: #e7807a; color: #d6463f; background: #fff0ee; }
.form-tip { margin-top: 9rpx; color: #99a4b5; font-size: 19rpx; line-height: 1.5; }
.back-preview { padding-top: 20rpx; text-align: center; color: #8793a8; font-size: 23rpx; }
.football-page .simulation-choice-cell { border-color: #f2c5c1; background: #fff6f5; color: #b5413d; }
