.football-page { padding: 24rpx 22rpx 180rpx; }
.source-head { display: flex; gap: 14rpx; justify-content: space-between; align-items: center; }
.heading { font-size: 36rpx; font-weight: 700; }
.source-note { margin-top: 8rpx; color: #8b97a9; font-size: 19rpx; }
.refresh { flex-shrink: 0; color: #25866a; font-size: 24rpx; padding: 10rpx; }
.market-scroll { margin-top: 24rpx; }
.markets { display: flex; width: max-content; gap: 12rpx; padding-bottom: 12rpx; }
.market { flex-shrink: 0; padding: 14rpx 22rpx; border-radius: 99rpx; color: #77849a; background: #eaf0f6; font-size: 23rpx; }
.market.active { color: #fff; background: #25866a; }
.selection-heading { display: flex; justify-content: space-between; margin: 16rpx 4rpx 20rpx; color: #8b97a9; font-size: 21rpx; }
.selection-heading text:last-child { color: #25866a; }
.state { padding: 54rpx 26rpx; color: #8793a8; font-size: 25rpx; text-align: center; line-height: 1.7; }
.retry { margin-top: 20rpx; color: #25866a; background: #e9f5ef; font-size: 24rpx; }
.match-card { padding: 22rpx; margin-bottom: 20rpx; }
.match-meta { display: flex; justify-content: space-between; gap: 10rpx; color: #8b97a9; font-size: 18rpx; }
.teams { display: flex; justify-content: center; align-items: center; gap: 22rpx; margin: 20rpx 0; font-size: 28rpx; font-weight: 650; }
.teams text { max-width: 45%; word-break: break-all; }
.versus { color: #a8b3c2; font-size: 21rpx; font-weight: 400; }
.selected-note { margin-bottom: 14rpx; color: #25866a; font-size: 20rpx; }
.pool + .pool { margin-top: 18rpx; }
.pool-heading { display: flex; justify-content: space-between; gap: 10rpx; margin-bottom: 12rpx; color: #7b889a; font-size: 21rpx; }
.eligibility { margin-left: 8rpx; color: #a5aeba; font-size: 18rpx; }
.eligibility.single { color: #25866a; }
.options { display: grid; grid-template-columns: repeat(3,1fr); gap: 10rpx; }
.options.scores, .options.goals { grid-template-columns: repeat(4,1fr); }
.option { padding: 13rpx 4rpx; border: 1rpx solid #e4eaf1; border-radius: 12rpx; background: #f8fafd; text-align: center; color: #536379; font-size: 22rpx; }
.option text { display: block; }
.odds { margin-top: 6rpx; color: #98a3b3; font-size: 19rpx; }
.option.chosen { background: #e3f5ed; border-color: #71b99e; color: #25866a; }
.option.chosen .odds { color: #25866a; }
.expand { margin-top: 18rpx; padding: 8rpx 0; text-align: center; color: #25866a; font-size: 21rpx; }
.pass-card { padding: 24rpx; margin-top: 24rpx; }
.mode-tabs { display: flex; gap: 12rpx; }
.mode { flex: 1; padding: 15rpx; border-radius: 14rpx; background: #f0f3f7; text-align: center; color: #8491a4; font-size: 24rpx; }
.mode.active { background: #e3f5ed; color: #25866a; }
.pass-hint { margin: 16rpx 0; color: #8b97a9; font-size: 20rpx; line-height: 1.6; }
.pass-options { display: flex; flex-wrap: wrap; gap: 12rpx; }
.pass { padding: 12rpx 20rpx; border-radius: 12rpx; border: 1rpx solid #e4eaf1; color: #7b889a; font-size: 23rpx; }
.pass.chosen { background: #e3f5ed; border-color: #71b99e; color: #25866a; }
.multiplier { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; color: #758296; font-size: 23rpx; }
.multiplier input { width: 150rpx; height: 62rpx; box-sizing: border-box; padding: 0 16rpx; background: #f5f7fa; border-radius: 12rpx; text-align: center; }
.calculation-error { margin-top: 16rpx; color: #bd7855; font-size: 21rpx; }
.reference-note { padding: 26rpx 10rpx; color: #98a3b3; font-size: 19rpx; line-height: 1.7; text-align: center; }
.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 10; display: flex; align-items: center; justify-content: space-between; padding: 20rpx 26rpx calc(20rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #edf1f5; background: #fff; }
.count { display: block; font-size: 24rpx; }
.settings-shortcut { padding: 16rpx 10rpx; color: #25866a; font-size: 23rpx; }
.cost { display: block; margin-top: 6rpx; color: #25866a; font-size: 28rpx; font-weight: 700; }
.preview-button { padding: 22rpx 36rpx; border-radius: 18rpx; background: #25866a; color: #fff; font-size: 25rpx; }
.floating-save { position: fixed; z-index: 20; right: 26rpx; bottom: calc(175rpx + env(safe-area-inset-bottom)); display: flex; width: 96rpx; height: 96rpx; flex-direction: column; align-items: center; justify-content: center; border-radius: 50%; color: #fff; background: #25866a; box-shadow: 0 8rpx 24rpx rgba(37,134,106,.25); font-size: 24rpx; }
.floating-save text { margin-top: 2rpx; font-size: 18rpx; }
.preview-mask { position: fixed; z-index: 100; top: 0; bottom: 0; left: 0; right: 0; display: flex; align-items: flex-end; background: rgba(20,35,50,.42); }
.preview-sheet { width: 100%; box-sizing: border-box; padding: 28rpx 26rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 30rpx 30rpx 0 0; background: #fff; }
.sheet-heading { display: flex; justify-content: space-between; align-items: center; font-size: 31rpx; font-weight: 650; }
.close { padding: 0 8rpx; font-size: 40rpx; color: #9aa7b7; }
.preview-content { height: 62vh; margin-top: 20rpx; }
.preview-stats { display: flex; flex-direction: column; gap: 10rpx; color: #8491a4; font-size: 22rpx; }
.preview-money { display: flex; margin: 22rpx 0; padding: 20rpx; border-radius: 14rpx; background: #f0f8f4; }
.preview-money view { flex: 1; color: #7b889a; font-size: 20rpx; }
.preview-money text { display: block; margin-top: 8rpx; color: #25866a; font-size: 32rpx; font-weight: 700; }
.preview-match { padding: 18rpx 0; border-top: 1rpx solid #edf1f5; font-size: 24rpx; }
.preview-match-time { margin-top: 6rpx; color: #98a3b3; font-size: 19rpx; }
.preview-choices { margin-top: 10rpx; color: #5b806f; line-height: 1.7; font-size: 22rpx; }
.ticket { padding: 16rpx; margin-bottom: 10rpx; background: #f7f9fc; border-radius: 12rpx; }
.ticket-title { color: #536a60; font-size: 22rpx; }
.ticket-choices { margin-top: 6rpx; color: #8491a4; font-size: 20rpx; line-height: 1.6; }
.load-more { padding: 16rpx; color: #25866a; text-align: center; font-size: 23rpx; }
.form-label { margin: 18rpx 0 12rpx; color: #7b889a; font-size: 22rpx; }
.form-input { height: 70rpx; box-sizing: border-box; padding: 0 18rpx; border-radius: 14rpx; background: #f5f7fa; font-size: 23rpx; }
.form-note { width: 100%; height: 130rpx; box-sizing: border-box; padding: 16rpx; border-radius: 14rpx; background: #f5f7fa; font-size: 23rpx; }
.save-button { margin-top: 20rpx; border-radius: 16rpx; background: #25866a; color: #fff; font-size: 25rpx; }
.save-button::after { border: none; }
