<view class="page football-page">
  <view class="source-head"><view><view class="heading">{{editMode ? '修改足球方案' : '足球模拟'}}</view><view class="source-note">本次查询：{{loading ? '查询中…' : fetchedAt || '等待查询'}}</view><view class="source-note">官方数据更新：{{updatedAt || '等待刷新'}} · 中国竞彩网</view></view><text class="refresh" bindtap="refreshFeed">刷新</text></view>
  <view class="simulation-notice">仅供个人方案模拟与赛后复盘。金额是本地计算的参考值；本小程序不提供真实投注、支付、出票或兑奖。</view>
  <view wx:if="{{draftRecovered}}" class="draft-notice">已从本机恢复上次页面，赛事和赔率按上次查询快照展示。点击「刷新」会清空当前选择并重新查询。</view>
  <scroll-view class="market-scroll" scroll-x="true"><view class="markets"><view wx:for="{{markets}}" wx:key="id" class="market {{market === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectMarket">{{item.name}}</view></view></scroll-view>
  <view class="selection-heading"><text>已选 {{selectedCount}} 场 · 同场多玩法 · 仅限同一期号</text></view>
  <view wx:if="{{loading}}" class="state card">正在查询官方最新赛事…</view>
  <view wx:elif="{{error}}" class="state card"><view>{{error}}</view><button class="retry" bindtap="refreshFeed">重试</button></view>
  <view wx:elif="{{!matches.length}}" class="state card"><view class="empty-match-symbol">⚽</view><view>当前暂无相关比赛，敬请期待。</view></view>
  <block wx:else>
    <view wx:for="{{matches}}" wx:key="id" class="match-card card">
      <view class="match-compact-head">
        <view class="match-info"><view class="match-tags"><text class="match-number">{{item.number}}</text><text class="match-league">{{item.league}}</text></view><text class="match-period">{{item.period}}期</text><text class="match-time">{{item.date}} {{item.time}}</text></view>
        <view class="compact-teams"><text>{{item.home}}</text><text class="versus">VS</text><text>{{item.away}}</text></view>
        <view class="match-tools"><text class="analyze-match" data-id="{{item.id}}" catchtap="openAnalysis">分析</text><text class="copy-match" data-id="{{item.id}}" catchtap="copyMatch">复制</text><text wx:if="{{market === 'mixed'}}" class="more-match" data-id="{{item.id}}" catchtap="expandMatch">{{item.expanded ? '收起' : '更多'}}</text></view>
      </view>
      <view wx:if="{{!item.selectable}}" class="readonly-note">{{item.statusLabel}} · 仅展示，不可选择</view>
      <view wx:elif="{{item.preOpen}}" class="preopen-note">未开盘，可先选择并保存；缺失赔率的回报待补全</view>
      <view wx:if="{{item.selectedOptions}}" class="selected-note">已选择 {{item.selectedOptions}} 项</view>
      <view wx:for="{{item.pools}}" wx:for-item="pool" wx:key="id" class="pool {{pool.id === 'had' || pool.id === 'hhad' ? 'result-pool' : ''}}">
        <view class="pool-body">
          <view class="pool-summary"><text class="pool-name">{{pool.name}}</text><text wx:if="{{pool.id === 'had' || pool.id === 'hhad'}}" class="pool-goal {{pool.id === 'hhad' ? 'adjusted' : ''}}">[{{pool.goalLabel}}]</text><text wx:if="{{pool.missing}}" class="pool-eligibility">未开放</text><text wx:elif="{{!pool.selectable}}" class="pool-eligibility">不可选</text><text wx:else class="pool-eligibility active">{{pool.single ? (pool.allUp ? '单/串' : '单关') : '串关'}}</text><text wx:if="{{pool.needsOdds}}" class="pool-eligibility pending">待赔率</text></view>
          <view class="options {{pool.id === 'crs' ? 'scores' : pool.id === 'ttg' ? 'goals' : ''}}">
            <view wx:for="{{pool.options}}" wx:for-item="option" wx:key="key" class="option {{option.selected ? 'chosen' : ''}} {{option.disabled ? 'disabled' : ''}}" data-key="{{option.selectionKey}}" data-match="{{item.id}}" data-pool="{{pool.id}}" bindtap="toggleOption"><text>{{option.name}}</text><text class="odds">{{option.oddsText}}</text></view>
          </view>
        </view>
      </view>
    </view>
  </block>
  <view class="reference-note">模拟回报区间按保存时的赔率和组合方式计算，仅供个人复盘参考；未计逐项舍入、上限及税费，不代表实际收益。</view>
  <view wx:if="{{passVisible}}" class="pass-mask" catchtap="closePasses">
    <view class="pass-sheet" catchtap="stopPropagation">
      <view class="sheet-heading"><text>组合方式</text><text class="close" catchtap="closePasses">×</text></view>
      <scroll-view class="pass-content" scroll-y="true" style="height: {{passPanelHeight}}rpx;">
        <view class="pass-options"><view wx:for="{{passes}}" wx:key="id" class="pass {{item.selected ? 'chosen' : ''}}" data-id="{{item.id}}" bindtap="togglePass">{{item.label}}</view></view>
      </scroll-view>
      <view class="pass-done" bindtap="closePasses">完成</view>
    </view>
  </view>
  <view wx:if="{{multiplierVisible}}" class="multiplier-mask" catchtap="closeMultiplier">
    <view class="multiplier-sheet" catchtap="stopPropagation">
      <view class="multiplier-heading"><view><text>选择倍率</text><text class="multiplier-draft">{{multiplierDraft || '请输入'}} 倍</text></view><text class="close" catchtap="closeMultiplier">×</text></view>
      <view class="multiplier-quick"><view wx:for="{{quickMultipliers}}" wx:key="*this" class="quick-item {{multiplierDraft == item ? 'active' : ''}}" data-value="{{item}}" bindtap="chooseQuickMultiplier">{{item}}倍</view></view>
      <view class="multiplier-keypad"><view wx:for="{{multiplierKeys}}" wx:key="*this" class="multiplier-key {{item === 'delete' || item === 'confirm' ? 'key-action' : ''}} {{item === 'confirm' ? 'key-confirm' : ''}}" data-key="{{item}}" bindtap="tapMultiplierKey">{{item === 'delete' ? '⌫' : item === 'confirm' ? '确定' : item}}</view></view>
    </view>
  </view>
  <view class="bottom-bar">
    <view class="bottom-controls"><text class="selected-badge">已选 {{selectedCount}} 场</text><view class="pass-trigger {{passVisible ? 'active' : ''}}" bindtap="configurePasses"><text>{{passLabel || '组合方式'}}</text><text>{{passVisible ? '⌄' : '⌃'}}</text></view><view class="multiplier" bindtap="openMultiplier"><text>{{multiplier}} 倍</text><text class="multiplier-arrow">⌃</text></view></view>
    <view class="bottom-total"><view class="total-money"><text class="count">{{summary ? summary.count : 0}} 组 · 模拟投入</text><text class="cost">¥{{summary ? summary.cost : '0.00'}}</text></view><view class="bottom-actions"><button class="clear-button" disabled="{{(!selectedCount && multiplier === '1') || loading}}" bindtap="clearSelections">清空</button><view wx:if="{{saved}}" class="preview-button" bindtap="viewPlans">查看我的方案</view><view wx:else class="preview-button" bindtap="openPreview">方案预览</view></view></view>
    <view class="prize-range"><text>模拟回报区间</text><text wx:if="{{summary && summary.needsOdds}}">待赔率 / 让球数公布</text><text wx:elif="{{summary}}">¥{{summary.minReturn}} ～ ¥{{summary.maxReturn}}</text><text wx:else>{{calculationError || (selectedCount ? '请选择可用组合方式' : '选择后实时计算')}}</text></view>
  </view>
  <view class="floating-save" bindtap="openPreview">{{saved ? '已保存' : '保存'}}<text>方案</text></view>
  <view wx:if="{{previewVisible}}" class="preview-mask" catchtap="closePreview">
    <view class="preview-dialog" catchtap="stopPropagation">
      <view class="preview-heading"><text>{{saveFormVisible ? (editMode ? '保存修改' : '保存方案') : '组合方式：' + preview.briefPassLabel}}</text><text class="close" catchtap="closePreview">×</text></view>
      <block wx:if="{{!saveFormVisible}}">
        <scroll-view class="brief-content" scroll-y="true" style="height: {{preview.briefHeight}}rpx;">
          <view wx:for="{{preview.matches}}" wx:key="id" class="brief-match"><view>{{item.label}}</view><view class="simulation-choice-box columns-{{item.selectionRows[0].columns}}"><view wx:for="{{item.selectionRows}}" wx:for-item="row" wx:key="id" class="simulation-choice-row"><text wx:for="{{row.options}}" wx:for-item="choice" wx:key="key" class="simulation-choice-cell">{{choice.text}}</text></view></view></view>
        </scroll-view>
        <view class="preview-actions"><button class="save-button" catchtap="openSaveForm">保存方案</button></view>
      </block>
      <view wx:else class="save-form">
        <view class="form-label">方案来源（选填）</view><scroll-view class="source-options" scroll-x="true"><view class="source-options-inner"><view class="source-option {{!planSourceId ? 'active' : ''}}" data-id="" bindtap="selectPlanSource">未关联</view><view wx:for="{{sources}}" wx:key="id" class="source-option {{planSourceId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectPlanSource">{{item.name}}</view></view></scroll-view>
        <view wx:if="{{!sources.length}}" class="form-tip">可先保存方案，再到“我的方案 → 来源管理”添加并关联。</view>
        <view class="form-label">备注（选填）</view><textarea class="form-note" maxlength="300" value="{{planNote}}" placeholder="记录选择原因，方便后续核对" bindinput="setNote" />
        <button class="save-button" loading="{{saving}}" disabled="{{saving || saved}}" catchtap="savePreview">{{saved ? '当前方案已保存' : editMode ? '保存修改' : '保存到我的方案'}}</button>
        <view class="back-preview" catchtap="backToPreview">返回预览</view>
      </view>
    </view>
  </view>
</view>
