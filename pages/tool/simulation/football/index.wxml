<view class="page football-page">
  <view class="source-head"><view><view class="heading">足球模拟</view><view class="source-note">数据来自中国竞彩网 · {{updatedAt || '等待刷新'}}</view></view><text class="refresh" bindtap="refreshFeed">刷新</text></view>
  <scroll-view class="market-scroll" scroll-x="true"><view class="markets"><view wx:for="{{markets}}" wx:key="id" class="market {{market === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectMarket">{{item.name}}</view></view></scroll-view>
  <view class="selection-heading"><text>已选 {{selectedCount}} 场 · 同场可选多个玩法</text></view>
  <view wx:if="{{loading}}" class="state card">正在查询官方最新赛事…</view>
  <view wx:elif="{{error}}" class="state card"><view>{{error}}</view><button class="retry" bindtap="refreshFeed">重试</button></view>
  <view wx:elif="{{!matches.length}}" class="state card">当前玩法暂无可用赛事</view>
  <block wx:else>
    <view wx:for="{{matches}}" wx:key="id" class="match-card card">
      <view class="match-meta"><text>{{item.number}} · {{item.league}}</text><text>{{item.date}} {{item.time}}</text></view>
      <view class="teams"><text>{{item.home}}</text><text class="versus">vs</text><text>{{item.away}}</text></view>
      <view wx:if="{{item.selectedOptions}}" class="selected-note">已选择 {{item.selectedOptions}} 项</view>
      <view wx:for="{{item.pools}}" wx:for-item="pool" wx:key="id" class="pool {{pool.id === 'had' || pool.id === 'hhad' ? 'result-pool' : ''}}">
        <view class="pool-heading"><text>{{pool.name}}</text><view><text wx:if="{{pool.missing}}" class="eligibility">暂未开放</text><block wx:else><text class="eligibility {{pool.single ? 'single' : ''}}">{{pool.single ? '可单关' : '仅串关'}}</text><text wx:if="{{!pool.allUp}}" class="eligibility">仅单关</text></block></view></view>
        <view class="pool-body">
          <view wx:if="{{pool.id === 'had' || pool.id === 'hhad'}}" class="handicap {{pool.id === 'hhad' ? 'adjusted' : ''}}"><text>[{{pool.goalLabel}}]</text><text class="handicap-note">{{pool.id === 'had' ? '普通' : '让球'}}</text></view>
          <view class="options {{pool.id === 'crs' ? 'scores' : pool.id === 'ttg' ? 'goals' : ''}}">
            <view wx:for="{{pool.options}}" wx:for-item="option" wx:key="key" class="option {{option.selected ? 'chosen' : ''}} {{option.disabled ? 'disabled' : ''}}" data-key="{{option.selectionKey}}" data-match="{{item.id}}" data-pool="{{pool.id}}" bindtap="toggleOption"><text>{{option.name}}</text><text class="odds">{{option.oddsText}}</text></view>
          </view>
        </view>
      </view>
      <view wx:if="{{market === 'mixed'}}" class="expand" data-id="{{item.id}}" bindtap="expandMatch">{{item.expanded ? '收起玩法 ↑' : '展开总进球 / 半全场 / 比分 ↓'}}</view>
    </view>
  </block>
  <view class="reference-note">理论金额区间为至少中一注时的税前总奖金，不含未中奖的 0 元；未计逐注舍入、奖金限额及税费。仅作方案模拟。</view>
  <view wx:if="{{passVisible}}" class="pass-mask" catchtap="closePasses">
    <view class="pass-sheet" catchtap="stopPropagation">
      <view class="sheet-heading"><text>过关选择</text><text class="close" catchtap="closePasses">×</text></view>
      <scroll-view class="pass-content" scroll-y="true" style="height: {{passPanelHeight}}rpx;">
        <view class="pass-hint">自由过关可多选。增减比赛自动选择最高可用关数；同一场数下保留手动选择。单关仅计算有单关资格的选项。</view>
        <view class="pass-options"><view wx:for="{{passes}}" wx:key="id" class="pass {{item.selected ? 'chosen' : ''}}" data-id="{{item.id}}" bindtap="togglePass">{{item.label}}</view></view>
        <view wx:if="{{!passes.length}}" class="pass-hint">请先选择比赛。仅串关的选择至少需要两场。</view>
        <view wx:if="{{calculationError}}" class="calculation-error">{{calculationError}}</view>
      </scroll-view>
      <view class="pass-done" bindtap="closePasses">完成</view>
    </view>
  </view>
  <view class="bottom-bar">
    <view class="bottom-controls"><text class="selected-badge">已选 {{selectedCount}} 场</text><view class="pass-trigger {{passVisible ? 'active' : ''}}" bindtap="configurePasses"><text>{{passLabel || '过关选择'}}</text><text>{{passVisible ? '⌄' : '⌃'}}</text></view><view class="multiplier"><input type="number" maxlength="4" value="{{multiplier}}" bindinput="setMultiplier" /><text>倍</text></view></view>
    <view class="bottom-total"><view class="total-money"><text class="count">{{summary ? summary.count : 0}} 注 · 投注金额</text><text class="cost">¥{{summary ? summary.cost : '0.00'}}</text></view><view class="bottom-actions"><button class="clear-button" disabled="{{!selectedCount || loading}}" bindtap="clearSelections">清空</button><view wx:if="{{saved}}" class="preview-button" bindtap="viewPlans">查看我的方案</view><view wx:else class="preview-button" bindtap="openPreview">方案预览</view></view></view>
    <view class="prize-range"><text>理论金额区间</text><text wx:if="{{summary}}">¥{{summary.minReturn}} ～ ¥{{summary.maxReturn}}</text><text wx:else>{{calculationError || (selectedCount ? '请选择可用过关方式' : '选择后实时计算')}}</text></view>
  </view>
  <view class="floating-save" bindtap="openPreview">{{saved ? '已保存' : '保存'}}<text>方案</text></view>
  <view wx:if="{{previewVisible}}" class="preview-mask" catchtap="closePreview">
    <view class="preview-dialog" catchtap="stopPropagation">
      <view class="preview-heading"><text>{{saveFormVisible ? '保存方案' : '过关方式：' + preview.briefPassLabel}}</text><text class="close" catchtap="closePreview">×</text></view>
      <block wx:if="{{!saveFormVisible}}">
        <scroll-view class="brief-content" scroll-y="true" style="height: {{preview.briefHeight}}rpx;">
          <view wx:for="{{preview.matches}}" wx:key="id" class="brief-match"><view>{{item.label}}</view><view class="simulation-choice-box"><view wx:for="{{item.selectionRows}}" wx:for-item="row" wx:key="id" class="simulation-choice-row"><text wx:for="{{row.options}}" wx:for-item="choice" wx:key="key" class="simulation-choice-cell">{{choice.text}}</text></view></view></view>
        </scroll-view>
        <view class="preview-actions"><button class="save-button" catchtap="openSaveForm">保存方案</button></view>
      </block>
      <view wx:else class="save-form">
        <view class="form-label">方案名称</view><input class="form-input" maxlength="60" value="{{planTitle}}" bindinput="setTitle" />
        <view class="form-label">备注（选填）</view><textarea class="form-note" maxlength="300" value="{{planNote}}" placeholder="记录选择原因，方便后续核对" bindinput="setNote" />
        <button class="save-button" loading="{{saving}}" disabled="{{saving || saved}}" catchtap="savePreview">{{saved ? '当前方案已保存' : '保存到我的方案'}}</button>
        <view class="back-preview" catchtap="backToPreview">返回预览</view>
      </view>
    </view>
  </view>
</view>
