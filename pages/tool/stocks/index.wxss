.page{padding:28rpx;background:#f4f6fa;min-height:100vh;color:#1d2939}.card{background:#fff;border-radius:24rpx;padding:28rpx;margin-bottom:22rpx}.status{background:#12352c;color:#e7fff3}.title{font-size:32rpx;font-weight:600;margin-bottom:12rpx}.muted{font-size:24rpx;color:#7a8697;margin-top:12rpx;line-height:1.6}.status .muted{color:#b1cbbc}.tabs{display:flex;gap:12rpx;margin:24rpx 0}.tabs>view{flex:1;text-align:center;padding:18rpx;background:#e9edf2;border-radius:16rpx}.tabs .active{background:#174b3b;color:white}.row{display:flex;justify-content:space-between;align-items:center}.price{font-size:38rpx;font-weight:600}.actions{display:flex;gap:16rpx;justify-content:flex-start;margin-top:18rpx}.actions button{margin:0}.field{padding:22rpx 0;border-bottom:1rpx solid #edf0f5}.search-result{padding:24rpx 0;border-bottom:1rpx solid #edf0f5}input{background:#f2f5f8;border-radius:12rpx;padding:22rpx;margin:18rpx 0;font-size:28rpx}button{margin-top:18rpx;font-size:28rpx;background:#e7f2ec;color:#174b3b}.error{margin-top:16rpx;color:#ffccb9;font-size:26rpx}
