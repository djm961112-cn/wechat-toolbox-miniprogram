<view class="page">
  <view class="card status"><view class="title">股票监控</view><text>{{providerState}}</text><view class="muted">监控在服务器运行，退出小程序后仍继续。</view><view wx:if="{{error}}" class="error">{{error}}</view></view>
  <view class="tabs"><view data-tab="watch" bindtap="selectTab" class="{{tab==='watch'?'active':''}}">自选</view><view data-tab="rules" bindtap="selectTab" class="{{tab==='rules'?'active':''}}">规则</view><view data-tab="history" bindtap="selectTab" class="{{tab==='history'?'active':''}}">告警</view><view data-tab="settings" bindtap="selectTab" class="{{tab==='settings'?'active':''}}">设置</view></view>
  <block wx:if="{{tab==='watch'}}">
    <view class="card"><input value="{{keyword}}" bindinput="inputKeyword" placeholder="股票名称或代码，例如 600519" /><view class="actions"><button size="mini" bindtap="search">搜索名称</button><button size="mini" bindtap="addCode">按代码添加</button></view><view wx:for="{{searchResults}}" wx:key="symbol" data-index="{{index}}" bindtap="addResult" class="search-result">{{item.name}} · {{item.symbol}}　＋</view></view>
    <view wx:for="{{watchlist}}" wx:key="symbol" class="card"><view class="row"><view><view class="title">{{item.name}}</view><text class="muted">{{item.symbol}}</text></view><view><view class="price">{{item.priceText}}</view><view>{{item.changeText}}</view></view></view><view class="muted">{{item.sourceText}} {{item.stale?'· 行情待更新/已过期':''}}</view><view class="actions"><button size="mini" data-symbol="{{item.symbol}}" bindtap="newRule">设置提醒</button><button size="mini" data-symbol="{{item.symbol}}" bindtap="removeStock">移除</button></view></view>
    <view wx:if="{{!watchlist.length}}" class="card muted">添加自选，再设置目标价格或涨跌幅。</view>
  </block>
  <block wx:if="{{tab==='rules'}}">
    <view wx:if="{{form.symbol}}" class="card"><view class="title">{{editingId?'编辑':'新增'}}规则 · {{form.symbol}}</view><picker range="{{['价格','日涨跌幅（相对昨收）']}}" value="{{form.metric==='PRICE'?0:1}}" bindchange="metric"><view class="field">指标：{{form.metric==='PRICE'?'价格':'日涨跌幅'}}</view></picker><picker range="{{['达到或高于','达到或低于']}}" value="{{form.comparison==='GTE'?0:1}}" bindchange="comparison"><view class="field">条件：{{form.comparison==='GTE'?'达到或高于':'达到或低于'}}</view></picker><input value="{{form.threshold}}" bindinput="inputThreshold" type="text" placeholder="目标值，跌幅可填写 -3" /><picker range="{{['提醒一次','每日一次']}}" value="{{form.repeatMode==='ONCE'?0:1}}" bindchange="repeat"><view class="field">频率：{{form.repeatMode==='ONCE'?'提醒一次':'每日一次'}}</view></picker><view class="row field"><text>启用规则</text><switch checked="{{form.enabled}}" bindchange="enabled" /></view><view class="row field"><text>当前已满足也提醒</text><switch checked="{{form.matchCurrent}}" bindchange="matchCurrent" /></view><view class="muted">默认等待新穿越；当前已满足时，先回到阈值另一侧才再次触发。仅连续交易时段判断。</view><button bindtap="saveRule" loading="{{busy}}">保存规则</button></view>
    <view wx:for="{{rules}}" wx:key="id" class="card"><view class="title">{{item.symbol}} · {{item.label}}</view><view class="muted">{{item.modeText}} · {{item.enabled?'启用':'已停用/已触发'}}</view><view class="actions"><button size="mini" data-id="{{item.id}}" bindtap="editRule">编辑</button><button size="mini" data-id="{{item.id}}" bindtap="deleteRule">删除</button></view></view><view wx:if="{{!rules.length}}" class="card muted">在自选股票上点击“设置提醒”。</view>
  </block>
  <block wx:if="{{tab==='history'}}"><view wx:for="{{events}}" wx:key="id" class="card"><view class="title">{{item.title}}</view><view>{{item.body}}</view><view class="muted">{{item.timeText}} · {{item.kind==='TEST'?'测试通知':'行情触发'}}</view></view><view wx:for="{{gaps}}" wx:key="id" class="card muted">{{item.text}}</view><view wx:if="{{!events.length}}" class="card muted">暂无告警记录。</view></block>
  <block wx:if="{{tab==='settings'}}">
    <view class="card"><view class="title">富途行情授权</view><view class="muted">在富途官方页面登录，只授权行情读取。不需要提供账号密码。</view><button bindtap="authorize">获取授权链接</button></view>
    <view class="card"><view class="title">iPhone 通知</view><view class="muted">{{barkConfigured?'已配置 Bark':'尚未配置'}}。在 Bark App 中复制默认推送地址或设备 Key，粘贴到下方。</view><input password value="{{barkKey}}" bindinput="inputBark" maxlength="512" placeholder="Bark Key 或推送地址" /><button bindtap="saveBark">保存手机推送</button><button wx:if="{{barkConfigured}}" bindtap="disableBark">关闭手机推送</button><button bindtap="testNotification">测试 Mac 和手机通知</button></view>
    <view class="card"><view class="title">配对 Mac</view><input type="number" maxlength="8" value="{{pairCode}}" bindinput="inputPair" placeholder="Mac 上显示的8位配对码" /><button bindtap="approvePair">确认配对</button><view wx:for="{{devices}}" wx:key="id" class="field row"><text>{{item.name}} · {{item.revokedAt?'已撤销':'已配对'}}</text><button wx:if="{{!item.revokedAt}}" size="mini" data-id="{{item.id}}" bindtap="revoke">撤销</button></view></view>
  </block>
</view>
