.vault-page { padding-top: 24rpx; }
.vault-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; }
.page-title { color: #192944; font-size: 38rpx; font-weight: 750; }
.page-subtitle { margin-top: 6rpx; color: #8995a8; font-size: 21rpx; }
.add-button { height: 66rpx; margin: 0; padding: 0 24rpx; border: 0; border-radius: 18rpx; background: #5568ec; color: #fff; font-size: 24rpx; font-weight: 650; line-height: 66rpx; }
.add-button::after, .copy-button::after, .empty-add-button::after, .cancel-button::after, .save-button::after { border: 0; }
.search-box { display: flex; height: 76rpx; align-items: center; margin-bottom: 20rpx; padding: 0 22rpx; border-radius: 20rpx; box-shadow: none; }
.search-icon { margin-right: 12rpx; color: #8995a9; font-size: 34rpx; }
.search-input { min-width: 0; flex: 1; font-size: 24rpx; }
.record-list { display: flex; flex-direction: column; gap: 18rpx; }
.record-card { padding: 24rpx; border-radius: 22rpx; }
.record-head, .password-row { display: flex; align-items: center; justify-content: space-between; }
.account-block, .password-block { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.field-label { color: #8a96aa; font-size: 20rpx; }
.account-value { overflow: hidden; margin-top: 5rpx; color: #1e2d49; font-size: 29rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.copy-button { height: 54rpx; flex-shrink: 0; margin: 0 0 0 18rpx; padding: 0 18rpx; border: 0; border-radius: 14rpx; background: #eef1ff; color: #5166e9; font-size: 21rpx; line-height: 54rpx; }
.platform-list { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; }
.platform-tag { padding: 7rpx 16rpx; border-radius: 99rpx; background: #f0f4ff; color: #5568c9; font-size: 20rpx; }
.password-row { margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid #edf0f5; }
.password-value { margin-top: 5rpx; color: #3f4b64; font-size: 29rpx; font-weight: 650; letter-spacing: 5rpx; }
.password-copy { background: #edf8f7; color: #259e96; }
.note-box { display: flex; margin-top: 20rpx; padding: 16rpx 18rpx; border-radius: 14rpx; background: #f8f9fc; }
.note-label { flex-shrink: 0; margin-right: 14rpx; color: #8b96a8; font-size: 20rpx; }
.note-text { color: #59667a; font-size: 21rpx; line-height: 1.55; word-break: break-all; }
.record-actions { display: flex; justify-content: flex-end; gap: 30rpx; margin-top: 20rpx; }
.action-link { padding: 6rpx 0; font-size: 22rpx; }
.action-link.edit { color: #5468eb; }
.action-link.merge { color: #269d96; }
.action-link.delete { color: #a0a8b5; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 70rpx 32rpx; text-align: center; }
.empty-image, .empty-icon { width: 110rpx; height: 110rpx; margin-bottom: 22rpx; }
.empty-icon { display: flex; align-items: center; justify-content: center; border-radius: 30rpx; background: #eef1ff; color: #596dec; font-size: 56rpx; }
.empty-title { color: #25344d; font-size: 29rpx; font-weight: 650; }
.empty-hint { margin-top: 12rpx; color: #8995a7; font-size: 22rpx; }
.empty-add-button { width: 100%; margin-top: 30rpx; border: 0; border-radius: 16rpx; background: #586bec; color: #fff; font-size: 25rpx; }
.security-note { margin: 24rpx 20rpx 0; color: #98a2b2; font-size: 19rpx; line-height: 1.6; text-align: center; }
.sheet-mask { position: fixed; z-index: 120; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; background: rgba(20,29,46,.42); }
.form-sheet, .merge-sheet { width: 100%; box-sizing: border-box; max-height: 88vh; overflow-y: auto; padding: 28rpx 28rpx calc(30rpx + env(safe-area-inset-bottom)); border-radius: 30rpx 30rpx 0 0; background: #fff; }
.sheet-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 26rpx; }
.sheet-title { color: #1e2c46; font-size: 31rpx; font-weight: 700; }
.sheet-close { padding: 4rpx 10rpx; color: #909bad; font-size: 42rpx; line-height: 1; }
.form-field { margin-bottom: 22rpx; }
.form-label { display: block; margin-bottom: 10rpx; color: #59667b; font-size: 23rpx; font-weight: 600; }
.form-input, .form-textarea { width: 100%; box-sizing: border-box; border: 1rpx solid #e5e9f1; border-radius: 15rpx; background: #f8f9fc; color: #23314b; font-size: 24rpx; }
.form-input { height: 76rpx; padding: 0 20rpx; }
.form-textarea { height: 136rpx; padding: 18rpx 20rpx; line-height: 1.5; }
.password-input-wrap { position: relative; }
.password-input { padding-right: 100rpx; }
.password-toggle { position: absolute; top: 0; right: 18rpx; height: 76rpx; color: #586bec; font-size: 21rpx; line-height: 76rpx; }
.sheet-actions { display: flex; gap: 16rpx; margin-top: 8rpx; }
.cancel-button, .save-button { height: 76rpx; flex: 1; margin: 0; border: 0; border-radius: 16rpx; font-size: 25rpx; line-height: 76rpx; }
.cancel-button { background: #f0f2f6; color: #68758a; }
.save-button { background: #586bec; color: #fff; }
.merge-hint { margin: -8rpx 0 20rpx; color: #8995a8; font-size: 21rpx; line-height: 1.6; }
.merge-list { display: flex; flex-direction: column; gap: 12rpx; }
.merge-item { padding: 20rpx; border: 1rpx solid #e7eaf2; border-radius: 16rpx; background: #f9faff; }
.merge-platforms { color: #283750; font-size: 25rpx; font-weight: 650; }
.merge-account { margin-top: 6rpx; color: #8a95a7; font-size: 21rpx; }
