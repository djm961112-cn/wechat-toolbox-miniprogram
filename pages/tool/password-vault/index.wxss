.vault-page { padding-top: 24rpx; }
.vault-page.merge-active { padding-bottom: 210rpx; }
.vault-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; }
.header-copy { min-width: 0; flex: 1; }
.page-title { color: #192944; font-size: 38rpx; font-weight: 750; }
.page-subtitle { margin-top: 6rpx; color: #8995a8; font-size: 21rpx; }
.header-actions { display: flex; flex-shrink: 0; gap: 12rpx; margin-left: 16rpx; }
.add-button, .merge-mode-button { display: flex; height: 62rpx; box-sizing: border-box; align-items: center; justify-content: center; border-radius: 16rpx; font-size: 22rpx; font-weight: 650; }
.add-button { width: 126rpx; background: #5568ec; color: #fff; }
.merge-mode-button { width: 92rpx; background: #eef1ff; color: #5568d5; }
.selecting-label { flex-shrink: 0; margin-left: 16rpx; color: #5568e5; font-size: 23rpx; font-weight: 650; }
.empty-add-button::after, .cancel-button::after, .save-button::after { border: 0; }
.search-box { display: flex; height: 76rpx; align-items: center; margin-bottom: 20rpx; padding: 0 22rpx; border-radius: 20rpx; box-shadow: none; }
.search-icon { margin-right: 12rpx; color: #8995a9; font-size: 34rpx; }
.search-input { min-width: 0; flex: 1; font-size: 24rpx; }
.record-list { display: flex; flex-direction: column; gap: 18rpx; }
.record-card { padding: 24rpx; border-radius: 22rpx; }
.record-card.selected { border-color: #7f8efa; background: #fbfbff; box-shadow: 0 0 0 2rpx rgba(85,104,236,.08); }
.platform-header { display: flex; min-width: 0; align-items: flex-start; justify-content: space-between; margin-bottom: 18rpx; }
.platform-list { display: flex; min-width: 0; flex: 1; flex-wrap: wrap; gap: 10rpx; overflow: visible; }
.platform-tag { display: block; max-width: 100%; box-sizing: border-box; padding: 8rpx 17rpx; border-radius: 22rpx; background: #eef1ff; color: #4f61c8; font-size: 21rpx; font-weight: 600; line-height: 1.45; white-space: normal; word-break: break-all; }
.select-check { display: flex; width: 38rpx; height: 38rpx; flex-shrink: 0; align-items: center; justify-content: center; margin-left: 14rpx; border: 2rpx solid #c8cfdd; border-radius: 50%; color: #fff; font-size: 23rpx; }
.select-check.checked { border-color: #586bec; background: #586bec; }
.credential-list { overflow: hidden; border: 1rpx solid #edf0f5; border-radius: 17rpx; background: #f9fafc; }
.credential-row { display: flex; min-height: 88rpx; align-items: center; justify-content: space-between; padding: 0 16rpx 0 18rpx; }
.credential-row + .credential-row { border-top: 1rpx solid #edf0f5; }
.credential-block { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.field-label { color: #8a96aa; font-size: 20rpx; }
.account-value { overflow: hidden; margin-top: 4rpx; color: #1e2d49; font-size: 27rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.password-value { margin-top: 4rpx; color: #3f4b64; font-size: 26rpx; font-weight: 650; letter-spacing: 4rpx; }
.password-value.visible { color: #253550; font-size: 23rpx; letter-spacing: 0; line-height: 1.35; word-break: break-all; }
.copy-button { display: flex; width: 76rpx; height: 46rpx; flex: 0 0 76rpx; align-items: center; justify-content: center; margin-left: 14rpx; border-radius: 12rpx; background: #edf0ff; color: #5166e9; font-size: 19rpx; }
.password-actions { display: flex; flex-shrink: 0; align-items: center; gap: 8rpx; margin-left: 14rpx; }
.password-actions .copy-button { margin-left: 0; }
.password-copy { background: #edf8f7; color: #259e96; }
.visibility-button { display: flex; width: 76rpx; height: 46rpx; flex: 0 0 76rpx; align-items: center; justify-content: center; border-radius: 12rpx; background: #f2f3f7; color: #68758a; font-size: 19rpx; }
.note-box { display: flex; margin-top: 20rpx; padding: 16rpx 18rpx; border-radius: 14rpx; background: #f8f9fc; }
.note-label { flex-shrink: 0; margin-right: 14rpx; color: #8b96a8; font-size: 20rpx; }
.note-text { color: #59667a; font-size: 21rpx; line-height: 1.55; word-break: break-all; }
.record-actions { display: flex; justify-content: flex-end; gap: 30rpx; margin-top: 20rpx; }
.action-link { padding: 6rpx 0; font-size: 22rpx; }
.action-link.edit { color: #5468eb; }
.action-link.copy { color: #269d96; }
.action-link.delete { color: #a0a8b5; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 70rpx 32rpx; text-align: center; }
.empty-image, .empty-icon { width: 110rpx; height: 110rpx; margin-bottom: 22rpx; }
.empty-icon { display: flex; align-items: center; justify-content: center; border-radius: 30rpx; background: #eef1ff; color: #596dec; font-size: 56rpx; }
.empty-title { color: #25344d; font-size: 29rpx; font-weight: 650; }
.empty-hint { margin-top: 12rpx; color: #8995a7; font-size: 22rpx; }
.empty-add-button { width: 100%; margin-top: 30rpx; border: 0; border-radius: 16rpx; background: #586bec; color: #fff; font-size: 25rpx; }
.security-note { margin: 24rpx 20rpx 0; color: #98a2b2; font-size: 19rpx; line-height: 1.6; text-align: center; }
.batch-bar { position: fixed; z-index: 100; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: space-between; padding: 18rpx 26rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e8ebf2; background: rgba(255,255,255,.98); box-shadow: 0 -8rpx 28rpx rgba(32,49,81,.08); }
.batch-summary { color: #6f7b8f; font-size: 22rpx; }
.batch-count { margin-right: 5rpx; color: #5568e5; font-size: 31rpx; font-weight: 750; }
.batch-actions { display: flex; gap: 12rpx; }
.batch-cancel, .batch-confirm { display: flex; height: 60rpx; align-items: center; justify-content: center; padding: 0 22rpx; border-radius: 14rpx; font-size: 22rpx; }
.batch-cancel { background: #f0f2f6; color: #68758a; }
.batch-confirm { background: #586bec; color: #fff; }
.sheet-mask { position: fixed; z-index: 120; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; background: rgba(20,29,46,.42); }
.form-sheet { width: 100%; box-sizing: border-box; max-height: 88vh; overflow-y: auto; padding: 28rpx 28rpx calc(30rpx + env(safe-area-inset-bottom)); border-radius: 30rpx 30rpx 0 0; background: #fff; }
.sheet-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 26rpx; }
.sheet-title { color: #1e2c46; font-size: 31rpx; font-weight: 700; }
.sheet-close { padding: 4rpx 10rpx; color: #909bad; font-size: 42rpx; line-height: 1; }
.form-field { margin-bottom: 22rpx; }
.form-label { display: block; margin-bottom: 10rpx; color: #59667b; font-size: 23rpx; font-weight: 600; }
.form-input, .form-textarea { width: 100%; box-sizing: border-box; border: 1rpx solid #e5e9f1; border-radius: 15rpx; background: #f8f9fc; color: #23314b; font-size: 24rpx; }
.form-input { height: 76rpx; padding: 0 20rpx; }
.form-textarea { height: 136rpx; padding: 18rpx 20rpx; line-height: 1.5; }
.password-input-wrap { position: relative; }
.password-input { padding-right: 100rpx; }
.password-toggle { position: absolute; top: 0; right: 18rpx; height: 76rpx; color: #586bec; font-size: 21rpx; line-height: 76rpx; }
.sheet-actions { display: flex; gap: 16rpx; margin-top: 8rpx; }
.cancel-button, .save-button { height: 76rpx; flex: 1; margin: 0; border: 0; border-radius: 16rpx; font-size: 25rpx; line-height: 76rpx; }
.cancel-button { background: #f0f2f6; color: #68758a; }
.save-button { background: #586bec; color: #fff; }
